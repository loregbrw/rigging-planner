@page "/new-plan/{PlanId:guid}/{Stage}"
@inject NavigationManager Navigation
@inject IDbContextFactory<AppDbContext> DbFactory
@inject PlanDraftState Draft

<RpPlanStepLayout Title="@PlanTitle"
                  Subtitle="@($"{PageTitle} - etapa do plano de rigging")"
                  PlanId="@PlanId"
                  WorkflowPlanId="@PlanId"
                  IsNew="@(!isPersisted)"
                  CurrentStep="@PlanStepCatalog.GetIndex(CurrentSegment)"
                  IsReadOnly="@isReadOnly"
                  Save="SavePlan"
                  Discard="DiscardChanges">
    @if (isLoading)
    {
        <p class="rp-muted">Carregando planilha...</p>
    }
    else if (CurrentSegment == "attachments")
    {
        <RpAttachmentsStage Plan="plan!" IsReadOnly="isReadOnly" />
    }
    else if (CurrentSegment == "preview")
    {
        <RpPreviewStage />
    }
    else if (CurrentSegment == "export")
    {
        <RpExportStage PlanId="@PlanId" IsReadOnly="@isReadOnly" OnFinalized="OnPlanFinalizedAsync" />
    }
    else
    {
        <RpStagePlaceholder Title="@PageTitle" />
    }
</RpPlanStepLayout>

@code {
    [Parameter] public Guid PlanId { get; set; }
    [Parameter] public string Stage { get; set; } = "attachments";

    private string CurrentSegment => string.IsNullOrWhiteSpace(Stage) ? "attachments" : Stage.ToLowerInvariant();
    private string PageTitle => PlanStepCatalog.GetTitle(CurrentSegment);
    private RiggingPlan? plan;
    private string PlanTitle => Draft.GetPageTitle(plan);
    private bool isPersisted;
    private bool isReadOnly;
    private bool isLoading = true;

    private void SavePlan() => Navigation.NavigateTo($"/new-plan/{PlanId}?save=true");

    private void DiscardChanges()
    {
        Draft.Reset();
        Draft.SuppressLeaveConfirmation = true;
        Navigation.NavigateTo("/");
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadFromDatabaseAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (loadedPlanId != PlanId)
        {
            await LoadFromDatabaseAsync();
        }
    }

    private Guid loadedPlanId;

    private async Task LoadFromDatabaseAsync()
    {
        isLoading = true;
        await using var db = await DbFactory.CreateDbContextAsync();

        plan = await PlanWorkflowLoader.LoadAsync(db, Draft, PlanId, useDraftFallback: true);

        if (plan is null)
        {
            Draft.PlanId = PlanId;
            Draft.Plan ??= new RiggingPlan { Id = PlanId };
            plan = Draft.Plan;
        }

        loadedPlanId = PlanId;
        isPersisted = Draft.IsPersisted;
        isReadOnly = plan?.Status == "finalized";
        isLoading = false;
    }

    private async Task OnPlanFinalizedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        plan = await PlanWorkflowLoader.LoadAsync(db, Draft, PlanId, includeAccessories: true);
        isPersisted = true;
        isReadOnly = plan?.Status == "finalized";
    }
}
