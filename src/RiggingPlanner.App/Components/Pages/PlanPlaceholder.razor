@page "/new-plan/{PlanId:guid}/{Stage}"
@inject NavigationManager Navigation
@inject IDbContextFactory<AppDbContext> DbFactory
@inject PlanDraftState Draft
@using RiggingPlanner.App.Components.Shared
@using Microsoft.AspNetCore.Components.Forms

<RpPageHeader Title="@PlanTitle" Subtitle="@($"{PageTitle} — etapa do plano de rigging")">
    <Actions>
        <RpPlanActions PlanId="@PlanId" IsReadOnly="@isReadOnly" IsSaving="isSaving"
                       IsNew="@(!isPersisted)" Save="SavePlan" Discard="DiscardChanges" />
    </Actions>
</RpPageHeader>

<RpPlanLeaveGuard PlanId="@PlanId" IsReadOnly="@isReadOnly" IsSaving="isSaving" />

<div class="rp-stack">
    <RpStepper Steps="steps" Links="stepLinks" Current="CurrentStep" />
    <RpPlanNavigation PreviousUrl="@PreviousUrl" NextUrl="@NextUrl" />

    @if (CurrentSegment == "attachments")
    {
        <RpCard Title="Anexos">
            <div class="rp-stack" style="gap: var(--rp-space-6);">
                <section class="rp-client-section" aria-labelledby="art-section-title">
                    <h3 id="art-section-title" class="rp-section-title">ART do Plano de Rigging</h3>
                    <p class="rp-help" style="margin-bottom: var(--rp-space-4);">
                        Informe o número da ART emitida no CREA e anexe o arquivo PDF correspondente. Este documento integrará o plano de rigging final.
                    </p>

                    @if (!string.IsNullOrWhiteSpace(errorMessage))
                    {
                        <div class="rp-alert rp-alert--danger" style="margin-bottom: var(--rp-space-4);">@errorMessage</div>
                    }

                    @if (plan is not null)
                    {
                        <div class="rp-form-grid" style="display:flex; flex-direction: column; gap: var(--rp-space-4);">
                            <div class="rp-field">
                                <label class="rp-label" for="art-number-input">Número da ART</label>
                                <input id="art-number-input" class="rp-input" @bind="plan.ArtNumber" disabled="@isReadOnly" />
                                <span class="rp-help">Ex: 1720264496217</span>
                            </div>

                            <div class="rp-field">
                                <label class="rp-label">Documento PDF da ART</label>
                                @if (plan.ArtFile is not null)
                                {
                                    <div style="display: flex; align-items: center; justify-content: space-between; padding: var(--rp-space-3) var(--rp-space-4); background: var(--rp-surface); border: 1px solid var(--rp-border-subtle); border-radius: var(--rp-radius-md);">
                                        <div style="display: flex; align-items: center; gap: var(--rp-space-3); overflow: hidden;">
                                            <svg class="rp-icon" style="color: var(--rp-accent); flex-shrink: 0;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                                                <polyline points="14 2 14 8 20 8"></polyline>
                                            </svg>
                                            <div style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                                                <div style="font-weight: 600; font-size: var(--rp-text-sm);">@plan.ArtFile.OriginalName</div>
                                                <div style="font-size: var(--rp-text-xs); color: var(--rp-text-secondary);">@FormatByteSize(plan.ArtFile.SizeBytes)</div>
                                            </div>
                                        </div>
                                        @if (!isReadOnly)
                                        {
                                            <div style="display: flex; gap: var(--rp-space-2); flex-shrink: 0;">
                                                <InputFile id="replace-art-file" class="rp-file-input" OnChange="OnArtFileChange" accept=".pdf,application/pdf" />
                                                <label class="rp-btn rp-btn--ghost rp-btn--sm" for="replace-art-file">Trocar</label>
                                                <button class="rp-btn rp-btn--danger-outline rp-btn--sm" type="button" @onclick="RemoveArtFileAsync">Excluir</button>
                                            </div>
                                        }
                                    </div>
                                }
                                else
                                {
                                    @if (!isReadOnly)
                                    {
                                        <div style="display: flex; flex-direction: column; gap: var(--rp-space-2);">
                                            <InputFile id="upload-art-file" class="rp-file-input" OnChange="OnArtFileChange" accept=".pdf,application/pdf" />
                                            <label class="rp-btn rp-btn--ghost" for="upload-art-file" style="display: inline-flex; align-items: center; justify-content: center; gap: var(--rp-space-2); cursor: pointer;">
                                                <svg class="rp-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                    <path d="M12 16V4m0 0-4 4m4-4 4 4M5 14v4a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-4" />
                                                </svg>
                                                Escolher arquivo PDF da ART
                                            </label>
                                            <span class="rp-help">Somente arquivo PDF (máx. 10MB)</span>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="rp-muted">Nenhum anexo de ART enviado.</span>
                                    }
                                }
                            </div>
                        </div>
                    }
                </section>
            </div>
        </RpCard>
    }
    else
    {
        <RpCard Title="@PageTitle">
            <div class="rp-empty">
                <p class="rp-empty__title">Esta etapa ainda está em preparação</p>
                <p class="rp-muted">A navegação já está disponível para organizar o fluxo do plano.</p>
            </div>
        </RpCard>
    }
</div>

@code {
    [Parameter] public Guid PlanId { get; set; }

    private readonly string[] steps = ["Dados de entrada", "Capacidade de Carga", "Anexos", "Preview", "Exportação"];
    private IReadOnlyList<string> stepLinks => [$"new-plan/{PlanId}", $"new-plan/{PlanId}/capacity", $"new-plan/{PlanId}/attachments", $"new-plan/{PlanId}/preview", $"new-plan/{PlanId}/export"];
    [Parameter] public string Stage { get; set; } = "attachments";
    private string CurrentSegment => Stage.ToLowerInvariant();
    private int CurrentStep => CurrentSegment switch
    {
        "attachments" => 2,
        "preview" => 3,
        "export" => 4,
        _ => 2
    };
    private string PageTitle => CurrentSegment switch
    {
        "attachments" => "Anexos",
        "preview" => "Preview",
        "export" => "Exportação",
        _ => "Etapa do plano"
    };
    private string? PreviousUrl => CurrentStep == 2 ? $"new-plan/{PlanId}/capacity" : CurrentStep == 3 ? $"new-plan/{PlanId}/attachments" : $"new-plan/{PlanId}/preview";
    private string? NextUrl => CurrentStep == 2 ? $"new-plan/{PlanId}/preview" : CurrentStep == 3 ? $"new-plan/{PlanId}/export" : null;
    private RiggingPlan? plan;
    private string PlanTitle => Draft.GetPageTitle(plan);
    private bool isPersisted;
    private bool isReadOnly;
    private bool isSaving;
    private string? errorMessage;

    private void SavePlan() => Navigation.NavigateTo($"/new-plan/{PlanId}?save=true");
    private void DiscardChanges()
    {
        Draft.Reset();
        Draft.SuppressLeaveConfirmation = true;
        Navigation.NavigateTo("/");
    }

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();

        if (Draft.PlanId == PlanId && Draft.Plan is not null && Draft.IsInitialized)
        {
            plan = Draft.Plan;
            isPersisted = Draft.IsPersisted;
            isReadOnly = Draft.Plan?.Status == "finalized";
        }
        else
        {
            plan = await db.RiggingPlans.Include(x => x.ArtFile).SingleOrDefaultAsync(x => x.Id == PlanId && x.DeletedAt == null);
            if (plan is not null)
            {
                Draft.Plan = plan;
                Draft.PlanId = PlanId;
                Draft.IsPersisted = true;
                Draft.IsInitialized = true;
            }
            else if (Draft.PlanId == PlanId && Draft.Plan is not null)
            {
                plan = Draft.Plan;
                isPersisted = Draft.IsPersisted;
            }
            else
            {
                Draft.PlanId = PlanId;
                Draft.Plan ??= new RiggingPlan { Id = PlanId };
                plan = Draft.Plan;
                isPersisted = false;
            }
            isReadOnly = plan?.Status == "finalized";
        }
    }

    private async Task OnArtFileChange(InputFileChangeEventArgs args)
    {
        if (plan is null || isReadOnly) return;
        var browserFile = args.File;
        if (browserFile is null) return;

        if (!string.Equals(browserFile.ContentType, "application/pdf", StringComparison.OrdinalIgnoreCase) &&
            !browserFile.Name.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase))
        {
            errorMessage = "Anexe somente arquivos PDF.";
            return;
        }

        try
        {
            errorMessage = null;
            var storedFile = await SaveFileAsync(browserFile);

            await using var db = await DbFactory.CreateDbContextAsync();
            db.StoredFiles.Add(storedFile);
            plan.ArtFileId = storedFile.Id;
            plan.ArtFile = storedFile;

            if (isPersisted)
            {
                var dbPlan = await db.RiggingPlans.FindAsync(PlanId);
                if (dbPlan is not null)
                {
                    dbPlan.ArtFileId = storedFile.Id;
                    dbPlan.ArtNumber = plan.ArtNumber;
                }
            }
            await db.SaveChangesAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Erro ao anexar arquivo: {ex.Message}";
        }
    }

    private async Task RemoveArtFileAsync()
    {
        if (plan is null || isReadOnly) return;
        plan.ArtFileId = null;
        plan.ArtFile = null;

        await using var db = await DbFactory.CreateDbContextAsync();
        if (isPersisted)
        {
            var dbPlan = await db.RiggingPlans.FindAsync(PlanId);
            if (dbPlan is not null)
            {
                dbPlan.ArtFileId = null;
                await db.SaveChangesAsync();
            }
        }
        else
        {
            await db.SaveChangesAsync();
        }
    }

    private static async Task<StoredFile> SaveFileAsync(IBrowserFile browserFile)
    {
        var fileId = Guid.NewGuid();
        var extension = Path.GetExtension(browserFile.Name);
        var folder = Path.Combine(FileSystem.AppDataDirectory, "rigging-plan-art");
        Directory.CreateDirectory(folder);
        var relativePath = Path.Combine("rigging-plan-art", fileId + extension);
        var absolutePath = Path.Combine(FileSystem.AppDataDirectory, relativePath);

        await using var input = browserFile.OpenReadStream(10 * 1024 * 1024);
        await using var output = File.Create(absolutePath);
        using var sha256 = System.Security.Cryptography.SHA256.Create();
        var buffer = new byte[81920];
        int read;
        long size = 0;
        while ((read = await input.ReadAsync(buffer)) > 0)
        {
            await output.WriteAsync(buffer.AsMemory(0, read));
            sha256.TransformBlock(buffer, 0, read, null, 0);
            size += read;
        }
        sha256.TransformFinalBlock([], 0, 0);
        var hash = Convert.ToHexString(sha256.Hash ?? []).ToLowerInvariant();

        return new StoredFile
        {
            Id = fileId,
            RelativePath = relativePath,
            OriginalName = browserFile.Name,
            ContentType = browserFile.ContentType,
            SizeBytes = size,
            Sha256 = hash,
            CreatedAt = DateTime.Now
        };
    }

    private static string FormatByteSize(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024.0:N1} KB";
        return $"{bytes / (1024.0 * 1024.0):N1} MB";
    }
}
