@page "/riggers"
@using System.ComponentModel.DataAnnotations
@inject IDbContextFactory<AppDbContext> DbFactory

<RpPageHeader Title="Riggers" Subtitle="Cadastre os responsáveis e seus registros para reutilizar nos planos" />

<div class="rp-stack">
    <RpCard Title="@(editingId is null ? "Novo rigger" : "Editar rigger")">
        @if (message is not null)
        {
            <div class="rp-alert rp-alert--success">@message</div>
        }
        <EditForm Model="form" OnValidSubmit="SaveAsync">
            <DataAnnotationsValidator />
            <div class="rp-form-grid">
                <div class="rp-field rp-col-6"><label class="rp-label">Nome completo</label><InputText class="rp-input" @bind-Value="form.FullName" /><ValidationMessage For="() => form.FullName" /></div>
                <div class="rp-field rp-col-6"><label class="rp-label">Nome de exibição</label><InputText class="rp-input" @bind-Value="form.DisplayName" /><ValidationMessage For="() => form.DisplayName" /></div>
                <div class="rp-field rp-col-6"><label class="rp-label">RPP</label><InputText class="rp-input" @bind-Value="form.RppNumber" /><ValidationMessage For="() => form.RppNumber" /></div>
                <div class="rp-field rp-col-6"><label class="rp-label">CREA (opcional)</label><InputText class="rp-input" @bind-Value="form.CreaNumber" /></div>
            </div>
            <div class="rp-form-actions">
                <button class="rp-btn rp-btn--primary" type="submit" disabled="@isSaving">@(editingId is null ? "Cadastrar rigger" : "Salvar alterações")</button>
                @if (editingId is not null)
                {
                    <button class="rp-btn rp-btn--ghost" type="button" @onclick="CancelEdit">Cancelar</button>
                }
            </div>
        </EditForm>
    </RpCard>
    <RpCard Title="Riggers cadastrados">
        <div class="rp-table-wrap"><table class="rp-table"><thead><tr><th>Nome</th><th>RPP</th><th>CREA</th><th>Status</th><th></th></tr></thead><tbody>
            @foreach (var rigger in riggers)
            {
                <tr><td>@rigger.DisplayName <span class="rp-muted">(@rigger.FullName)</span></td><td>@rigger.RppNumber</td><td>@(rigger.CreaNumber ?? "-")</td><td><span class="rp-badge @(rigger.IsActive ? "rp-badge--success" : "rp-badge--warning")">@(rigger.IsActive ? "Ativo" : "Inativo")</span></td><td class="rp-row-actions"><button class="rp-btn rp-btn--ghost rp-btn--sm" @onclick="() => BeginEdit(rigger)">Editar</button> <button class="rp-btn rp-btn--ghost rp-btn--sm" @onclick="() => ToggleStatusAsync(rigger)">@(rigger.IsActive ? "Inativar" : "Ativar")</button></td></tr>
            }
        </tbody></table></div>
    </RpCard>
</div>

@code {
    private List<Rigger> riggers = [];
    private RiggerForm form = new();
    private Guid? editingId;
    private string? message;
    private bool isSaving;

    protected override async Task OnInitializedAsync() => await LoadAsync();
    private async Task LoadAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        riggers = await db.Riggers.AsNoTracking().OrderBy(x => x.DisplayName).ToListAsync();
    }
    private async Task SaveAsync()
    {
        isSaving = true;
        await using var db = await DbFactory.CreateDbContextAsync();
        var stored = editingId is null ? null : await db.Riggers.FindAsync(editingId.Value);
        if (editingId is not null && stored is null)
        {
            message = "O rigger não foi encontrado.";
            isSaving = false;
            return;
        }

        if (stored is null)
        {
            db.Riggers.Add(new Rigger
            {
                Id = Guid.NewGuid(),
                FullName = form.FullName.Trim(),
                DisplayName = form.DisplayName.Trim(),
                RppNumber = form.RppNumber.Trim(),
                CreaNumber = string.IsNullOrWhiteSpace(form.CreaNumber) ? null : form.CreaNumber.Trim(),
                IsActive = true
            });
        }
        else
        {
            stored.FullName = form.FullName.Trim();
            stored.DisplayName = form.DisplayName.Trim();
            stored.RppNumber = form.RppNumber.Trim();
            stored.CreaNumber = string.IsNullOrWhiteSpace(form.CreaNumber) ? null : form.CreaNumber.Trim();
        }

        await db.SaveChangesAsync();
        form = new();
        editingId = null;
        message = stored is null ? "Rigger cadastrado com sucesso." : "Rigger atualizado com sucesso.";
        isSaving = false;
        await LoadAsync();
    }

    private void BeginEdit(Rigger rigger)
    {
        editingId = rigger.Id;
        form = new RiggerForm
        {
            FullName = rigger.FullName,
            DisplayName = rigger.DisplayName,
            RppNumber = rigger.RppNumber,
            CreaNumber = rigger.CreaNumber
        };
        message = null;
    }

    private void CancelEdit()
    {
        editingId = null;
        form = new();
        message = null;
    }
    private async Task ToggleStatusAsync(Rigger rigger)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var stored = await db.Riggers.FindAsync(rigger.Id);
        if (stored is null) return;
        stored.IsActive = !stored.IsActive;
        await db.SaveChangesAsync();
        await LoadAsync();
    }
    private sealed class RiggerForm
    {
        [Required(ErrorMessage = "Informe o nome completo.")] public string FullName { get; set; } = string.Empty;
        [Required(ErrorMessage = "Informe o nome de exibição.")] public string DisplayName { get; set; } = string.Empty;
        [Required(ErrorMessage = "Informe o RPP.")] public string RppNumber { get; set; } = string.Empty;
        public string? CreaNumber { get; set; }
    }
}
