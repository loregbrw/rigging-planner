@page "/riggers"
@using System.ComponentModel.DataAnnotations
@inject IDbContextFactory<AppDbContext> DbFactory

<RpPageHeader Title="Riggers" Subtitle="Cadastre os responsáveis e seus registros para reutilizar nos planos" />

<div class="rp-stack">
    <RpCard Title="@(editingId is null ? "Novo rigger" : "Editar rigger")">
        @if (message is not null)
        {
            <div class="rp-alert rp-alert--success">@message</div>
        }
        <EditForm Model="form" OnValidSubmit="SaveAsync">
            <DataAnnotationsValidator />
            <div class="rp-form-grid">
                <div class="rp-field rp-col-6"><label class="rp-label">Nome completo <span class="rp-required-marker" aria-hidden="true">*</span></label><InputText class="rp-input" @bind-Value="form.FullName" /><ValidationMessage For="() => form.FullName" /></div>
                <div class="rp-field rp-col-6"><label class="rp-label">Nome de exibição <span class="rp-required-marker" aria-hidden="true">*</span></label><InputText class="rp-input" @bind-Value="form.DisplayName" /><ValidationMessage For="() => form.DisplayName" /></div>
                <div class="rp-field rp-col-6"><label class="rp-label">RPP <span class="rp-required-marker" aria-hidden="true">*</span></label><InputText class="rp-input" @bind-Value="form.RppNumber" /><ValidationMessage For="() => form.RppNumber" /></div>
                <div class="rp-field rp-col-6"><label class="rp-label">CREA <span class="rp-required-marker" aria-hidden="true">*</span></label><InputText class="rp-input" @bind-Value="form.CreaNumber" /><ValidationMessage For="() => form.CreaNumber" /></div>
            </div>
            <div class="rp-form-actions">
                <button class="rp-btn rp-btn--primary" type="submit" disabled="@isSaving">@(editingId is null ? "Cadastrar rigger" : "Salvar alterações")</button>
                @if (editingId is not null)
                {
                    <button class="rp-btn rp-btn--ghost" type="button" @onclick="CancelEdit">Cancelar</button>
                }
            </div>
        </EditForm>
    </RpCard>
    <RpCard Title="Riggers ativos">
        <div class="rp-table-wrap"><table class="rp-table"><thead><tr><th>Nome</th><th>RPP</th><th>CREA</th><th></th></tr></thead><tbody>
            @foreach (var rigger in activeRiggers)
            {
                <tr><td>@rigger.DisplayName <span class="rp-muted">(@rigger.FullName)</span></td><td>@rigger.RppNumber</td><td>@(rigger.CreaNumber ?? "-")</td><td class="rp-row-actions"><button class="rp-btn rp-btn--ghost rp-btn--sm" @onclick="() => BeginEdit(rigger)">Editar</button> <button class="rp-btn rp-btn--ghost rp-btn--sm" @onclick="() => ToggleStatusAsync(rigger)">Inativar</button></td></tr>
            }
        </tbody></table></div>
    </RpCard>
    <RpInactiveSection TItem="Rigger"
                       Title="Riggers inativos"
                       Description="Riggers inativos não podem ser editados nem selecionados em novos planos."
                       EmptyText="Nenhum rigger inativo."
                       Items="inactiveRiggers">
        <HeaderTemplate><th>Nome</th><th>RPP</th><th>CREA</th><th></th></HeaderTemplate>
        <RowTemplate Context="rigger">
            <tr class="rp-row--inactive"><td>@rigger.DisplayName <span class="rp-muted">(@rigger.FullName)</span></td><td>@rigger.RppNumber</td><td>@(rigger.CreaNumber ?? "-")</td><td class="rp-row-actions"><button class="rp-btn rp-btn--ghost rp-btn--sm" @onclick="() => ToggleStatusAsync(rigger)">Reativar</button> <button class="rp-btn rp-btn--danger-outline rp-btn--sm" disabled="@(deleteId == rigger.Id)" @onclick="() => AskDelete(rigger)">Excluir definitivamente</button></td></tr>
            @if (deleteId == rigger.Id)
            {
                <tr class="rp-row--inactive"><td colspan="4"><div class="rp-alert rp-alert--danger rp-confirm"><span>@(deleteMessage ?? "Você está prestes a excluir este rigger permanentemente. Essa informação não poderá ser recuperada. Planos já finalizados continuam preservando os dados históricos; planos em andamento impedem a exclusão.")</span><button class="rp-btn rp-btn--danger rp-btn--sm" @onclick="DeleteAsync">Excluir definitivamente</button><button class="rp-btn rp-btn--ghost rp-btn--sm" @onclick="CancelDelete">Cancelar</button></div></td></tr>
            }
        </RowTemplate>
    </RpInactiveSection>
</div>

@code {
    private List<Rigger> activeRiggers = [];
    private List<Rigger> inactiveRiggers = [];
    private RiggerForm form = new();
    private Guid? editingId;
    private string? message;
    private bool isSaving;
    private Guid? deleteId;
    private string? deleteMessage;

    protected override async Task OnInitializedAsync() => await LoadAsync();
    private async Task LoadAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        activeRiggers = await db.Riggers.AsNoTracking().Where(x => x.IsActive).OrderBy(x => x.DisplayName).ToListAsync();
        inactiveRiggers = await db.Riggers.AsNoTracking().Where(x => !x.IsActive).OrderBy(x => x.DisplayName).ToListAsync();
    }
    private async Task SaveAsync()
    {
        isSaving = true;
        await using var db = await DbFactory.CreateDbContextAsync();
        var stored = editingId is null ? null : await db.Riggers.FindAsync(editingId.Value);
        if (editingId is not null && stored is null)
        {
            message = "O rigger não foi encontrado.";
            isSaving = false;
            return;
        }

        if (stored is null)
        {
            db.Riggers.Add(new Rigger
            {
                Id = Guid.NewGuid(),
                FullName = form.FullName.Trim(),
                DisplayName = form.DisplayName.Trim(),
                RppNumber = form.RppNumber.Trim(),
                CreaNumber = string.IsNullOrWhiteSpace(form.CreaNumber) ? null : form.CreaNumber.Trim(),
                IsActive = true
            });
        }
        else
        {
            stored.FullName = form.FullName.Trim();
            stored.DisplayName = form.DisplayName.Trim();
            stored.RppNumber = form.RppNumber.Trim();
            stored.CreaNumber = string.IsNullOrWhiteSpace(form.CreaNumber) ? null : form.CreaNumber.Trim();
        }

        await db.SaveChangesAsync();
        form = new();
        editingId = null;
        message = stored is null ? "Rigger cadastrado com sucesso." : "Rigger atualizado com sucesso.";
        isSaving = false;
        await LoadAsync();
    }

    private void BeginEdit(Rigger rigger)
    {
        editingId = rigger.Id;
        form = new RiggerForm
        {
            FullName = rigger.FullName,
            DisplayName = rigger.DisplayName,
            RppNumber = rigger.RppNumber,
            CreaNumber = rigger.CreaNumber
        };
        message = null;
    }
    private void AskDelete(Rigger rigger) { deleteId = rigger.Id; deleteMessage = null; }
    private void CancelDelete() { deleteId = null; deleteMessage = null; }

    private void CancelEdit()
    {
        editingId = null;
        form = new();
        message = null;
    }
    private async Task ToggleStatusAsync(Rigger rigger)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var stored = await db.Riggers.FindAsync(rigger.Id);
        if (stored is null) return;
        stored.IsActive = !stored.IsActive;
        await db.SaveChangesAsync();
        await LoadAsync();
    }
    private async Task DeleteAsync()
    {
        if (deleteId is null) return;
        await using var db = await DbFactory.CreateDbContextAsync();
        var rigger = await db.Riggers.FindAsync(deleteId.Value);
        if (rigger is null) { CancelDelete(); return; }
        var inProgressUse = await db.RiggingPlans.AnyAsync(x => x.RiggerId == rigger.Id && x.DeletedAt == null && x.Status != "finalized");
        if (inProgressUse)
        {
            deleteMessage = "Não é possível excluir: o rigger está ligado a um plano em andamento.";
            return;
        }
        db.Riggers.Remove(rigger);
        await db.SaveChangesAsync();
        CancelDelete();
        await LoadAsync();
    }
    private sealed class RiggerForm
    {
        [Required(ErrorMessage = "Informe o nome completo.")] public string FullName { get; set; } = string.Empty;
        [Required(ErrorMessage = "Informe o nome de exibição.")] public string DisplayName { get; set; } = string.Empty;
        [Required(ErrorMessage = "Informe o RPP.")] public string RppNumber { get; set; } = string.Empty;
        [Required(ErrorMessage = "Informe o CREA.")] public string? CreaNumber { get; set; }
    }
}
