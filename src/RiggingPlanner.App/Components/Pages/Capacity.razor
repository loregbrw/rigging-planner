@page "/new-plan/{PlanId:guid}/capacity"
@inject PlanDraftState Draft
@inject IPlanService Plans
@inject NavigationManager Navigation

<RpPlanStepLayout Title="@PageTitle"
                  Subtitle="Capacidade de carga - Registre os valores do engenheiro e confira os totais calculados"
                  PlanId="@PlanId"
                  WorkflowPlanId="@PlanId"
                  IsNew="@IsDraft"
                  CurrentStep="@PlanStepCatalog.Capacity"
                  ShowNavigation="@(!isLoading && State?.Plan is not null)"
                  IsReadOnly="@(State?.IsReadOnly ?? false)"
                  IsSaving="false"
                  Save="SavePlanAsync"
                  Discard="DiscardChanges">
    @if (isLoading)
    {
        <p class="rp-muted">Carregando planilha...</p>
    }
    else if (State?.Plan is null)
    {
        <div class="rp-alert rp-alert--danger">Plano não encontrado.</div>
    }
    else
    {
        @if (State.ErrorMessage is not null)
        {
            <div class="rp-alert rp-alert--danger">@State.ErrorMessage</div>
        }
        @if (State.IsReadOnly)
        {
            <div class="rp-alert rp-alert--info">Este plano foi finalizado e está somente para leitura.</div>
        }

        <RpCard Title="Capacidade de carga">
            <fieldset disabled="@State.IsReadOnly" class="rp-readonly-fields">
                <div class="rp-stack" style="gap: var(--rp-space-6);">
                    <RpCapacityAccessorySection State="State.Lingada"
                                                Title="Lingadas / Amarras"
                                                SectionId="lingada-section"
                                                HelpText="Gerencie as lingadas e amarras diretamente na tabela abaixo."
                                                TotalLabel="PESO TOTAL DA LINGADA / AMARRAÇÃO"
                                                EmptyText="Nenhuma lingada ou amarra cadastrada. Clique no botão &quot;+&quot; acima para adicionar."
                                                AddTitle="Adicionar lingada"
                                                ConfirmText="Confirma a exclusão desta lingada?"
                                                DescriptionPlaceholder="Descrição da lingada..."
                                                QuantityHeader="Qtd. (pç)"
                                                QuantityWidth="110px"
                                                UnitWidth="140px"
                                                TotalWidth="130px" />

                    <RpCapacityAccessorySection State="State.Device"
                                                Title="Dispositivos / Balancim"
                                                SectionId="device-section"
                                                HelpText="Gerencie os dispositivos e balancins diretamente na tabela abaixo."
                                                TotalLabel="PESO TOTAL DO DISPOSITIVO / BALANCIM"
                                                EmptyText="Nenhum dispositivo ou balancim cadastrado. Clique no botão &quot;+&quot; acima para adicionar."
                                                AddTitle="Adicionar dispositivo"
                                                ConfirmText="Confirma a exclusão deste dispositivo?"
                                                DescriptionPlaceholder="Descrição..." />

                    <div class="rp-capacity-sections">
                        <RpCapacityCraneConfigSection Plan="State.Plan!" Changed="State.NotifyChanged" />
                        <RpCapacityGrossLoadSection Plan="State.Plan!"
                                                    LingadaTotal="State.Lingada.Total"
                                                    DeviceTotal="State.Device.Total"
                                                    GrossWeight="State.GrossWeight"
                                                    Changed="State.NotifyChanged" />
                    </div>

                    <RpCapacityQuadrantSection Plan="State.Plan!" />

                    <RpCapacityResultsSection Plan="State.Plan!" Utilization="State.Utilization" />
                </div>
            </fieldset>
        </RpCard>
    }
</RpPlanStepLayout>

@code {
    [Parameter] public Guid PlanId { get; set; }

    private CapacityState State = null!;
    private bool isLoading = true;
    private bool IsDraft => Draft.PlanId == PlanId && Draft.Plan is not null && !Draft.IsPersisted;
    private string PageTitle => Draft.GetPageTitle(State?.Plan);

    protected override async Task OnInitializedAsync()
    {
        State = new CapacityState(Draft)
        {
            PlanId = PlanId,
            Changed = StateHasChanged
        };

        var hasDraft = Draft.PlanId == PlanId && Draft.Plan is not null && Draft.IsInitialized;

        State.Plan = await PlanDraftLoader.LoadAsync(Plans, Draft, PlanId, includeAccessories: true);
        State.IsReadOnly = State.Plan?.Status == "finalized";

        if (hasDraft && State.Plan is not null && !string.IsNullOrWhiteSpace(Draft.Form.OperationName))
        {
            PlanFormMapper.ApplyToDraftPlan(Draft.Form, State.Plan);
        }

        isLoading = false;
    }

    private async Task SavePlanAsync()
    {
        if (State.Plan is null || State.IsReadOnly) return;
        Navigation.NavigateTo($"/new-plan/{PlanId}?save=true");
    }

    private void DiscardChanges()
    {
        Draft.Reset();
        Draft.SuppressLeaveConfirmation = true;
        Navigation.NavigateTo("/");
    }
}
