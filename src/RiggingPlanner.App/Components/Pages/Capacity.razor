@page "/new-plan/{PlanId:guid}/capacity"
@inject PlanDraftState Draft
@using System.ComponentModel.DataAnnotations
@inject IDbContextFactory<AppDbContext> DbFactory
@inject NavigationManager Navigation

<RpPageHeader Title="@PageTitle" Subtitle="Capacidade de carga — Registre os valores do engenheiro e confira os totais calculados">
    <Actions>
        <RpPlanActions PlanId="@PlanId" IsNew="@IsDraft" IsReadOnly="@isReadOnly"
                       IsSaving="false" Save="SavePlanAsync" Discard="DiscardChanges" />
    </Actions>
</RpPageHeader>

<RpPlanLeaveGuard PlanId="@PlanId" IsReadOnly="@isReadOnly" IsSaving="false" />

@if (isLoading)
{
    <p class="rp-muted">Carregando planilha...</p>
}
else if (plan is null)
{
    <div class="rp-alert rp-alert--danger">Plano não encontrado.</div>
}
else
{
    <div class="rp-stack">
        <RpStepper Steps="steps" Links="stepLinks" Current="1" />
        <RpPlanNavigation PreviousUrl="@($"new-plan/{PlanId}")"
                          NextUrl="@($"new-plan/{PlanId}/attachments")" />
        @if (errorMessage is not null) { <div class="rp-alert rp-alert--danger">@errorMessage</div> }
        @if (isReadOnly) { <div class="rp-alert rp-alert--info">Este plano foi finalizado e está somente para leitura.</div> }

        <RpCard Title="Capacidade de carga">
            <fieldset disabled="@isReadOnly" class="rp-readonly-fields">
                <div class="rp-stack" style="gap: var(--rp-space-6);">
                    
                    <!-- Subseção 1 & 2: Configurações do guindaste e Composição de carga bruta (Lado a lado) -->
                    <div class="rp-capacity-sections">
                        <section class="rp-capacity-section" aria-labelledby="crane-config-section">
                            <h3 id="crane-config-section" class="rp-section-title">Configurações do guindaste</h3>
                            <div class="rp-form-grid" style="grid-template-columns: 1fr;">
                                <div class="rp-field">
                                    <label class="rp-label">Capacidade nominal</label>
                                    <div class="rp-input-with-unit">
                                        <RpDecimalInput class="rp-input rp-input--num" @bind-Value="plan.CraneNominalCapacity" />
                                        <span class="rp-input-unit">t</span>
                                    </div>
                                </div>
                                <div class="rp-field">
                                    <label class="rp-label">Comprimento da lança</label>
                                    <div class="rp-input-with-unit">
                                        <RpDecimalInput class="rp-input rp-input--num" @bind-Value="plan.BoomLengthM" />
                                        <span class="rp-input-unit">m</span>
                                    </div>
                                </div>
                                <div class="rp-field">
                                    <label class="rp-label">Raio de operação</label>
                                    <div class="rp-input-with-unit">
                                        <RpDecimalInput class="rp-input rp-input--num" @bind-Value="plan.OperatingRadiusM" />
                                        <span class="rp-input-unit">m</span>
                                    </div>
                                </div>
                                <div class="rp-field">
                                    <label class="rp-label">Capacidade de carga</label>
                                    <div class="rp-input-with-unit">
                                        <RpDecimalInput class="rp-input rp-input--num" @bind-Value="plan.LoadCapacityT" />
                                        <span class="rp-input-unit">t</span>
                                    </div>
                                </div>
                            </div>
                        </section>

                        <section class="rp-capacity-section" aria-labelledby="gross-load-section">
                            <h3 id="gross-load-section" class="rp-section-title">Composição de carga bruta</h3>
                            <div class="rp-form-grid" style="grid-template-columns: 1fr;">
                                <div class="rp-field">
                                    <label class="rp-label">Carga líquida</label>
                                    <div class="rp-input-with-unit">
                                        <RpDecimalInput class="rp-input rp-input--num" @bind-Value="plan.WeightKg" />
                                        <span class="rp-input-unit">kg</span>
                                    </div>
                                </div>
                                <div class="rp-field">
                                    <label class="rp-label">Cargas extras</label>
                                    <div class="rp-input-with-unit">
                                        <RpDecimalInput class="rp-input rp-input--num" @bind-Value="plan.ExtraLoadKg" />
                                        <span class="rp-input-unit">kg</span>
                                    </div>
                                </div>
                                <div class="rp-field">
                                    <label class="rp-label">Lingada / Amarração <span style="font-weight: normal; font-size: 0.75rem; color: var(--rp-text-secondary);">(Tabela abaixo)</span></label>
                                    <div class="rp-input-with-unit">
                                        <input class="rp-input rp-input--disabled rp-input--num" value="@lingadaTotal.ToString("N2")" disabled />
                                        <span class="rp-input-unit">kg</span>
                                    </div>
                                </div>
                                <div class="rp-field">
                                    <label class="rp-label">Dispositivos / Balancim <span style="font-weight: normal; font-size: 0.75rem; color: var(--rp-text-secondary);">(Tabela abaixo)</span></label>
                                    <div class="rp-input-with-unit">
                                        <input class="rp-input rp-input--disabled rp-input--num" value="@deviceTotal.ToString("N2")" disabled />
                                        <span class="rp-input-unit">kg</span>
                                    </div>
                                </div>
                            </div>
                            <div class="rp-capacity-total-box" style="display: flex; align-items: center; justify-content: space-between; padding: var(--rp-space-3) var(--rp-space-4); background: var(--rp-primary-50); border: 1px solid var(--rp-primary-100); border-radius: var(--rp-radius-md); margin-top: var(--rp-space-3);">
                                <span style="font-weight: 600; color: var(--rp-primary-900);">Carga bruta total</span>
                                <span style="font-size: 1.1rem; font-weight: 700; color: var(--rp-primary-800); font-variant-numeric: tabular-nums;">@grossWeight.ToString("N2") kg</span>    
                            </div>
                        </section>
                    </div>

                    <!-- Subseção 3: Lingadas / Amarras -->
                    <section class="rp-capacity-section" aria-labelledby="lingada-section">
                        <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: var(--rp-space-2);">
                            <h3 id="lingada-section" class="rp-section-title" style="margin: 0;">Lingadas / Amarras</h3>
                            @if (lingadaForm.EditingId is not null)
                            {
                                <span class="rp-tag" style="background: var(--rp-primary-100); color: var(--rp-primary-900); font-weight: 600;">Modo de edição</span>
                            }
                        </div>
                        <p class="rp-help" style="margin-bottom: var(--rp-space-3);">Adicione, edite ou remova as lingadas e amarras utilizadas no plano de rigging.</p>

                        <!-- Formulário compacto de adição/edição de lingada -->
                        <div style="background: var(--rp-surface-subtle); border: 1px solid var(--rp-border-subtle); border-radius: var(--rp-radius-md); padding: var(--rp-space-3); margin-bottom: var(--rp-space-3);">
                            <div class="rp-form-grid" style="grid-template-columns: repeat(12, 1fr); display: grid; gap: var(--rp-space-2); align-items: end;">
                                <div class="rp-field rp-col-6" style="grid-column: span 6; margin-bottom: 0;">
                                    <label class="rp-label">Descrição <span class="rp-required-marker" aria-hidden="true">*</span></label>
                                    <InputText class="rp-input" @bind-Value="lingadaForm.Description" placeholder="Ex: Cinta plana 3 metros — Capacidade 6t" />
                                </div>
                                <div class="rp-field rp-col-2" style="grid-column: span 2; margin-bottom: 0;">
                                    <label class="rp-label">Qtd. (pç) <span class="rp-required-marker" aria-hidden="true">*</span></label>
                                    <RpDecimalInput class="rp-input rp-input--num" @bind-Value="lingadaForm.Quantity" />
                                </div>
                                <div class="rp-field rp-col-2" style="grid-column: span 2; margin-bottom: 0;">
                                    <label class="rp-label">Peso unit. (kg) <span class="rp-required-marker" aria-hidden="true">*</span></label>
                                    <RpDecimalInput class="rp-input rp-input--num" @bind-Value="lingadaForm.UnitWeightKg" />
                                </div>
                                <div class="rp-field rp-col-2" style="grid-column: span 2; margin-bottom: 0; display: flex; gap: var(--rp-space-2);">
                                    @if (lingadaForm.EditingId is not null)
                                    {
                                        <button class="rp-btn rp-btn--ghost rp-btn--sm" type="button" @onclick="CancelEditLingada" title="Cancelar">Cancelar</button>
                                    }
                                    <button class="rp-btn rp-btn--primary rp-btn--sm" type="button" style="width: 100%; height: 2.375rem;" @onclick="SaveLingadaAsync">@(lingadaForm.EditingId is null ? "Adicionar" : "Salvar")</button>
                                </div>
                            </div>
                        </div>

                        <!-- Tabela de lingadas -->
                        <div class="rp-table-wrap" style="background: var(--rp-surface-subtle); border-radius: var(--rp-radius-md); padding: var(--rp-space-2); border: 1px solid var(--rp-border-subtle);">
                            <table class="rp-table" style="background: transparent;">
                                <thead>
                                    <tr>
                                        <th style="width: 70px;">Item</th>
                                        <th>Descrição</th>
                                        <th class="rp-num">Qtd. (pç)</th>
                                        <th class="rp-num">Unitário (kg)</th>
                                        <th class="rp-num">Total (kg)</th>
                                        <th style="width: 140px;"></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{ int lingadaIndex = 1; }
                                    @foreach (var item in lingadaItems)
                                    {
                                        <tr class="@(lingadaForm.EditingId == item.Id ? "rp-row-highlight" : string.Empty)">
                                            <td>@(lingadaIndex++)</td>
                                            <td>@item.Description</td>
                                            <td class="rp-num">@item.Quantity.ToString("N2")</td>
                                            <td class="rp-num">@item.UnitWeightKg.ToString("N2") kg</td>
                                            <td class="rp-num">@((item.Quantity * item.UnitWeightKg).ToString("N2")) kg</td>
                                            <td class="rp-row-actions">
                                                <button class="rp-btn rp-btn--ghost rp-btn--sm" type="button" @onclick="() => EditLingada(item)">Editar</button>
                                                <button class="rp-btn rp-btn--ghost rp-btn--sm" type="button" @onclick="() => RemoveItemAsync(item.Id)">Remover</button>
                                            </td>
                                        </tr>
                                    }
                                    @if (!lingadaItems.Any())
                                    {
                                        <tr><td colspan="6" class="rp-muted" style="text-align: center; padding: var(--rp-space-3);">Nenhuma lingada ou amarra cadastrada.</td></tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <div style="margin-top: var(--rp-space-3); font-weight: 600; color: var(--rp-primary-800); text-align: right;">
                            PESO TOTAL DA LINGADA / AMARRAÇÃO: @lingadaTotal.ToString("N2") kg
                        </div>
                    </section>

                    <!-- Subseção 4: Dispositivos / Balancim -->
                    <section class="rp-capacity-section" aria-labelledby="device-section">
                        <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: var(--rp-space-2);">
                            <h3 id="device-section" class="rp-section-title" style="margin: 0;">Dispositivos / Balancim</h3>
                            @if (deviceForm.EditingId is not null)
                            {
                                <span class="rp-tag" style="background: var(--rp-primary-100); color: var(--rp-primary-900); font-weight: 600;">Modo de edição</span>
                            }
                        </div>
                        <p class="rp-help" style="margin-bottom: var(--rp-space-3);">Adicione, edite ou remova os dispositivos e balancins utilizados no plano de rigging.</p>

                        <!-- Formulário compacto de adição/edição de dispositivo -->
                        <div style="background: var(--rp-surface-subtle); border: 1px solid var(--rp-border-subtle); border-radius: var(--rp-radius-md); padding: var(--rp-space-3); margin-bottom: var(--rp-space-3);">
                            <div class="rp-form-grid" style="grid-template-columns: repeat(12, 1fr); display: grid; gap: var(--rp-space-2); align-items: end;">
                                <div class="rp-field rp-col-5" style="grid-column: span 5; margin-bottom: 0;">
                                    <label class="rp-label">Descrição <span class="rp-required-marker" aria-hidden="true">*</span></label>
                                    <InputText class="rp-input" @bind-Value="deviceForm.Description" placeholder="Ex: Balancim modular 10t" />
                                </div>
                                <div class="rp-field rp-col-2" style="grid-column: span 2; margin-bottom: 0;">
                                    <label class="rp-label">Ref. / Desenho</label>
                                    <InputText class="rp-input" @bind-Value="deviceForm.DrawingRef" placeholder="Ex: BAL-01" />
                                </div>
                                <div class="rp-field rp-col-1" style="grid-column: span 1; margin-bottom: 0;">
                                    <label class="rp-label">Qtd.</label>
                                    <RpDecimalInput class="rp-input rp-input--num" @bind-Value="deviceForm.Quantity" />
                                </div>
                                <div class="rp-field rp-col-2" style="grid-column: span 2; margin-bottom: 0;">
                                    <label class="rp-label">Peso unit. (kg)</label>
                                    <RpDecimalInput class="rp-input rp-input--num" @bind-Value="deviceForm.UnitWeightKg" />
                                </div>
                                <div class="rp-field rp-col-2" style="grid-column: span 2; margin-bottom: 0; display: flex; gap: var(--rp-space-2);">
                                    @if (deviceForm.EditingId is not null)
                                    {
                                        <button class="rp-btn rp-btn--ghost rp-btn--sm" type="button" @onclick="CancelEditDevice" title="Cancelar">Cancelar</button>
                                    }
                                    <button class="rp-btn rp-btn--primary rp-btn--sm" type="button" style="width: 100%; height: 2.375rem;" @onclick="SaveDeviceAsync">@(deviceForm.EditingId is null ? "Adicionar" : "Salvar")</button>
                                </div>
                            </div>
                        </div>

                        <!-- Tabela de dispositivos -->
                        <div class="rp-table-wrap" style="background: var(--rp-surface-subtle); border-radius: var(--rp-radius-md); padding: var(--rp-space-2); border: 1px solid var(--rp-border-subtle);">
                            <table class="rp-table" style="background: transparent;">
                                <thead>
                                    <tr>
                                        <th style="width: 70px;">Item</th>
                                        <th>Descrição</th>
                                        <th>Ref. / Desenho</th>
                                        <th class="rp-num">Qtd. (pç)</th>
                                        <th class="rp-num">Unitário (kg)</th>
                                        <th class="rp-num">Total (kg)</th>
                                        <th style="width: 140px;"></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{ int deviceIndex = lingadaItems.Count + 1; }
                                    @foreach (var item in deviceItems)
                                    {
                                        <tr class="@(deviceForm.EditingId == item.Id ? "rp-row-highlight" : string.Empty)">
                                            <td>@(deviceIndex++)</td>
                                            <td>@item.Description</td>
                                            <td>@(string.IsNullOrWhiteSpace(item.DrawingRef) ? "-" : item.DrawingRef)</td>
                                            <td class="rp-num">@item.Quantity.ToString("N2")</td>
                                            <td class="rp-num">@item.UnitWeightKg.ToString("N2") kg</td>
                                            <td class="rp-num">@((item.Quantity * item.UnitWeightKg).ToString("N2")) kg</td>
                                            <td class="rp-row-actions">
                                                <button class="rp-btn rp-btn--ghost rp-btn--sm" type="button" @onclick="() => EditDevice(item)">Editar</button>
                                                <button class="rp-btn rp-btn--ghost rp-btn--sm" type="button" @onclick="() => RemoveItemAsync(item.Id)">Remover</button>
                                            </td>
                                        </tr>
                                    }
                                    @if (!deviceItems.Any())
                                    {
                                        <tr><td colspan="7" class="rp-muted" style="text-align: center; padding: var(--rp-space-3);">Nenhum dispositivo ou balancim cadastrado.</td></tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <div style="margin-top: var(--rp-space-3); font-weight: 600; color: var(--rp-primary-800); text-align: right;">
                            PESO TOTAL DO DISPOSITIVO / BALANCIM: @deviceTotal.ToString("N2") kg
                        </div>
                    </section>

                </div>
            </fieldset>
        </RpCard>
    </div>
}

@code {
    [Parameter] public Guid PlanId { get; set; }
    private bool IsDraft => Draft.PlanId == PlanId && Draft.Plan is not null && !Draft.IsPersisted;
    private bool planWasLoadedFromDatabase;
    private RiggingPlan? plan;
    private List<PlanAccessory> items = [];
    private LingadaForm lingadaForm = new();
    private DeviceForm deviceForm = new();
    private bool isLoading = true;
    private bool isReadOnly;
    private string? errorMessage;
    private List<PlanAccessory> lingadaItems => items.Where(x => x.Section == "lingada").ToList();
    private List<PlanAccessory> deviceItems => items.Where(x => x.Section == "dispositivo").ToList();
    private decimal lingadaTotal => lingadaItems.Sum(x => x.Quantity * x.UnitWeightKg);
    private decimal deviceTotal => deviceItems.Sum(x => x.Quantity * x.UnitWeightKg);
    private decimal grossWeight => (plan?.WeightKg ?? 0) + lingadaTotal + deviceTotal + (plan?.ExtraLoadKg ?? 0);
    private decimal grossWeightTons => grossWeight / 1000;
    private decimal? utilization => plan?.LoadCapacityT is > 0 ? grossWeightTons / plan.LoadCapacityT.Value * 100 : null;
    private readonly string[] steps = ["Dados de entrada", "Capacidade de Carga", "Anexos", "Preview", "Exportação"];
    private IReadOnlyList<string> stepLinks => [$"new-plan/{PlanId}", $"new-plan/{PlanId}/capacity", $"new-plan/{PlanId}/attachments", $"new-plan/{PlanId}/preview", $"new-plan/{PlanId}/export"];
    private string PageTitle => Draft.GetPageTitle(plan);

    protected override async Task OnInitializedAsync()
    {
        if (Draft.PlanId == PlanId && Draft.Plan is not null && Draft.IsInitialized)
        {
            plan = Draft.Plan;
            SyncEntryFormIntoDraftPlan();
            items = Draft.Accessories;
            isReadOnly = plan.Status == "finalized";
            planWasLoadedFromDatabase = false;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        plan ??= await db.RiggingPlans.SingleOrDefaultAsync(x => x.Id == PlanId && x.DeletedAt == null);
        planWasLoadedFromDatabase = plan is not null && Draft.Plan != plan;
        isReadOnly = plan?.Status == "finalized";

        if (plan is not null && planWasLoadedFromDatabase)
        {
            items = await db.PlanAccessories.Where(x => x.PlanId == PlanId).OrderBy(x => x.SortOrder).ToListAsync();
            Draft.Plan = plan;
            Draft.PlanId = PlanId;
            Draft.Accessories.Clear();
            Draft.Accessories.AddRange(items);
            Draft.IsPersisted = true;
            Draft.IsInitialized = true;
        }
        isLoading = false;
    }

    private void SyncEntryFormIntoDraftPlan()
    {
        if (plan is null || string.IsNullOrWhiteSpace(Draft.Form.OperationName)) return;

        var form = Draft.Form;
        plan.OperationName = form.OperationName.Trim();
        plan.Location = form.Location.Trim();
        plan.PlanDate = form.PlanDate;
        plan.ClientId = form.ClientId;
        plan.ClientName = form.ClientName?.Trim();
        plan.ClientCnpj = form.ClientCnpj;
        plan.LoadDescription = form.LoadDescription.Trim();
        plan.LengthM = form.LengthM;
        plan.WidthM = form.WidthM;
        plan.HeightM = form.HeightM;
        plan.WeightKg = form.WeightKg;
        plan.EquipmentId = form.EquipmentId;
        plan.CraneModel = form.EquipmentModel;
        plan.TruckModel = form.EquipmentTruckModel;
        plan.ChassisNumber = form.EquipmentChassisNumber;
        plan.LicensePlate = form.EquipmentLicensePlate;
        plan.ManufactureYear = form.EquipmentManufactureYear;
        plan.CraneNominalCapacity = form.EquipmentNominalCapacity;
        plan.RiggerId = form.RiggerId;
        plan.RiggerName = form.RiggerDisplayName.Trim();
        plan.RiggerRpp = form.RiggerRppNumber.Trim();
        plan.RiggerCrea = string.IsNullOrWhiteSpace(form.RiggerCreaNumber) ? null : form.RiggerCreaNumber.Trim();
        plan.Observations = string.IsNullOrWhiteSpace(form.Observations) ? null : form.Observations.Trim();
    }

    private async Task SavePlanAsync()
    {
        if (plan is null || isReadOnly) return;
        Navigation.NavigateTo($"/new-plan/{PlanId}?save=true");
    }

    private void EditLingada(PlanAccessory item)
    {
        lingadaForm = new LingadaForm
        {
            EditingId = item.Id,
            Description = item.Description,
            Quantity = item.Quantity,
            UnitWeightKg = item.UnitWeightKg
        };
        errorMessage = null;
    }

    private void CancelEditLingada()
    {
        lingadaForm = new();
        errorMessage = null;
    }

    private async Task SaveLingadaAsync()
    {
        if (plan is null || isReadOnly) return;
        if (string.IsNullOrWhiteSpace(lingadaForm.Description) || lingadaForm.Quantity is not > 0 || lingadaForm.UnitWeightKg is null)
        {
            errorMessage = "Preencha a descrição, quantidade e peso unitário válidos para a lingada.";
            return;
        }

        if (lingadaForm.EditingId is null)
        {
            var newItem = new PlanAccessory
            {
                Id = Guid.NewGuid(),
                PlanId = PlanId,
                Section = "lingada",
                Description = lingadaForm.Description.Trim(),
                DrawingRef = null,
                Quantity = lingadaForm.Quantity.Value,
                UnitWeightKg = lingadaForm.UnitWeightKg.Value,
                SortOrder = items.Count == 0 ? 1 : items.Max(x => x.SortOrder) + 1
            };
            items.Add(newItem);
        }
        else
        {
            var existing = items.FirstOrDefault(x => x.Id == lingadaForm.EditingId);
            if (existing is not null)
            {
                existing.Description = lingadaForm.Description.Trim();
                existing.Quantity = lingadaForm.Quantity.Value;
                existing.UnitWeightKg = lingadaForm.UnitWeightKg.Value;
            }
        }

        lingadaForm = new();
        errorMessage = null;
    }

    private void EditDevice(PlanAccessory item)
    {
        deviceForm = new DeviceForm
        {
            EditingId = item.Id,
            Description = item.Description,
            DrawingRef = item.DrawingRef,
            Quantity = item.Quantity,
            UnitWeightKg = item.UnitWeightKg
        };
        errorMessage = null;
    }

    private void CancelEditDevice()
    {
        deviceForm = new();
        errorMessage = null;
    }

    private async Task SaveDeviceAsync()
    {
        if (plan is null || isReadOnly) return;
        if (string.IsNullOrWhiteSpace(deviceForm.Description) || deviceForm.Quantity is not > 0 || deviceForm.UnitWeightKg is null)
        {
            errorMessage = "Preencha a descrição, quantidade e peso unitário válidos para o dispositivo.";
            return;
        }

        if (deviceForm.EditingId is null)
        {
            var newItem = new PlanAccessory
            {
                Id = Guid.NewGuid(),
                PlanId = PlanId,
                Section = "dispositivo",
                Description = deviceForm.Description.Trim(),
                DrawingRef = string.IsNullOrWhiteSpace(deviceForm.DrawingRef) ? null : deviceForm.DrawingRef.Trim(),
                Quantity = deviceForm.Quantity.Value,
                UnitWeightKg = deviceForm.UnitWeightKg.Value,
                SortOrder = items.Count == 0 ? 1 : items.Max(x => x.SortOrder) + 1
            };
            items.Add(newItem);
        }
        else
        {
            var existing = items.FirstOrDefault(x => x.Id == deviceForm.EditingId);
            if (existing is not null)
            {
                existing.Description = deviceForm.Description.Trim();
                existing.DrawingRef = string.IsNullOrWhiteSpace(deviceForm.DrawingRef) ? null : deviceForm.DrawingRef.Trim();
                existing.Quantity = deviceForm.Quantity.Value;
                existing.UnitWeightKg = deviceForm.UnitWeightKg.Value;
            }
        }

        deviceForm = new();
        errorMessage = null;
    }

    private async Task RemoveItemAsync(Guid id)
    {
        if (isReadOnly) return;
        items.RemoveAll(x => x.Id == id);
        if (lingadaForm.EditingId == id) lingadaForm = new();
        if (deviceForm.EditingId == id) deviceForm = new();
    }

    private void DiscardChanges()
    {
        Draft.Reset();
        Draft.SuppressLeaveConfirmation = true;
        Navigation.NavigateTo("/");
    }

    private sealed class LingadaForm
    {
        public Guid? EditingId { get; set; }
        [Required(ErrorMessage = "Informe a descrição da lingada.")] public string Description { get; set; } = string.Empty;
        [Range(0.01, double.MaxValue)] public decimal? Quantity { get; set; } = 1;
        [Range(0.01, double.MaxValue)] public decimal? UnitWeightKg { get; set; }
    }

    private sealed class DeviceForm
    {
        public Guid? EditingId { get; set; }
        [Required(ErrorMessage = "Informe a descrição do dispositivo.")] public string Description { get; set; } = string.Empty;
        public string? DrawingRef { get; set; }
        [Range(0.01, double.MaxValue)] public decimal? Quantity { get; set; } = 1;
        [Range(0.01, double.MaxValue)] public decimal? UnitWeightKg { get; set; }
    }
}
