@page "/"
@inject IPlanService PlanService
@inject IExportService ExportService

@if (isLoading)
{
    <p class="rp-muted">Carregando planos...</p>
}
else
{
    <RpPageHeader Title="Planos" Subtitle="Organize e acompanhe seus planos de rigging">
        <Actions>
            <a class="rp-btn rp-btn--primary" href="new-plan">Novo plano</a>
        </Actions>
    </RpPageHeader>

    <RpCard Title="Planos de rigging">
        @if (rowMessage is not null)
        {
            <div class="rp-alert @(rowMessageIsError ? "rp-alert--danger" : "rp-alert--success")">@rowMessage</div>
        }
        @foreach (var warning in rowWarnings)
        {
            <div class="rp-alert rp-alert--warning">@warning</div>
        }

        @if (plans.Count == 0)
        {
            <div class="rp-empty">
                <p class="rp-empty__title">Nenhum plano criado ainda</p>
                <p class="rp-muted">Comece criando um plano para centralizar os dados da operação.</p>
                <div><a class="rp-btn rp-btn--primary" href="new-plan">Criar primeiro plano</a></div>
            </div>
        }
        else
        {
            <div class="rp-table-wrap">
                <table class="rp-table">
                    <thead>
                        <tr><th>Número</th><th>Operação</th><th>Cliente</th><th>Data</th><th>Status</th><th aria-label="Ações"></th></tr>
                    </thead>
                    <tbody>
                        @foreach (var plan in plans)
                        {
                            <tr>
                                <td class="rp-code">@plan.PlanNumber</td>
                                <td>@plan.OperationName</td>
                                <td>@(plan.ClientName ?? "Sem cliente")</td>
                                <td class="rp-data">@plan.PlanDate.ToString("dd/MM/yyyy")</td>
                                <td><span class="rp-badge @(plan.Status == "finalized" ? "rp-badge--success" : "rp-badge--primary")">@(plan.Status == "finalized" ? "Finalizado" : "Rascunho")</span></td>
                                <td class="rp-row-actions">
                                    @if (plan.Status != "finalized")
                                    {
                                        <a class="rp-btn rp-btn--ghost rp-btn--sm" href="@($"new-plan/{plan.Id}")">Abrir</a>
                                    }
                                    <button class="rp-btn rp-btn--ghost rp-btn--sm" type="button"
                                            title="Exportar PDF" aria-label="Exportar PDF"
                                            disabled="@(exportingPlanId is not null)"
                                            @onclick="() => ExportAsync(plan)">
                                        <svg class="rp-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                            <path d="M12 3v12" />
                                            <path d="m7 10 5 5 5-5" />
                                            <path d="M4 17v3h16v-3" />
                                        </svg>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </RpCard>
}

@code {
    private List<RiggingPlan> plans = [];
    private bool isLoading = true;
    private Guid? exportingPlanId;
    private string? rowMessage;
    private bool rowMessageIsError;
    private IReadOnlyList<string> rowWarnings = [];

    protected override async Task OnInitializedAsync()
    {
        await LoadPlansAsync();
    }

    private async Task LoadPlansAsync()
    {
        plans = [.. await PlanService.ListPlansAsync()];
        isLoading = false;
    }

    private async Task ExportAsync(RiggingPlan plan)
    {
        if (exportingPlanId is not null)
        {
            return;
        }

        exportingPlanId = plan.Id;
        rowMessage = null;
        rowMessageIsError = false;
        rowWarnings = [];
        try
        {
            var document = await ExportService.BuildAsync(plan.Id);
            var filePath = await PlanPdfWriter.SaveAndOpenAsync(document);
            rowMessage = $"PDF exportado: {filePath}";
            rowWarnings = document.Warnings;
        }
        catch (Exception ex)
        {
            rowMessageIsError = true;
            rowMessage = $"Não foi possível exportar o PDF: {ex.Message}";
        }
        finally
        {
            exportingPlanId = null;
        }
    }
}
