@page "/"
@inject IDbContextFactory<AppDbContext> DbFactory
@using RiggingPlanner.Domain.Services

@if (isLoading)
{
    <p class="rp-muted">Carregando planos...</p>
}
else
{
    <RpPageHeader Title="Planos" Subtitle="Organize e acompanhe seus planos de rigging">
        <Actions>
            <a class="rp-btn rp-btn--primary" href="new-plan">Novo plano</a>
        </Actions>
    </RpPageHeader>

    <RpCard Title="Planos de rigging">
        @if (errorMessage is not null)
        {
            <div class="rp-alert rp-alert--danger">@errorMessage</div>
        }
        @if (plans.Count == 0)
        {
            <div class="rp-empty">
                <p class="rp-empty__title">Nenhum plano criado ainda</p>
                <p class="rp-muted">Comece criando um plano para centralizar os dados da operação.</p>
                <div><a class="rp-btn rp-btn--primary" href="new-plan">Criar primeiro plano</a></div>
            </div>
        }
        else
        {
            <div class="rp-table-wrap">
                <table class="rp-table">
                    <thead>
                        <tr><th>Número</th><th>Operação</th><th>Cliente</th><th>Data</th><th>Status</th><th aria-label="Ações"></th></tr>
                    </thead>
                    <tbody>
                        @foreach (var plan in plans)
                        {
                            <tr>
                                <td class="rp-code">@plan.PlanNumber</td>
                                <td>@plan.OperationName</td>
                                <td>@(plan.ClientName ?? "Sem cliente")</td>
                                <td class="rp-data">@plan.PlanDate.ToString("dd/MM/yyyy")</td>
                                <td><span class="rp-badge @(plan.Status == "finalized" ? "rp-badge--success" : "rp-badge--primary")">@(plan.Status == "finalized" ? "Finalizado" : "Rascunho")</span></td>
                                <td class="rp-row-actions">
                                    <a class="rp-btn rp-btn--ghost rp-btn--sm" href="@($"new-plan/{plan.Id}")">@(plan.Status == "finalized" ? "Visualizar" : "Abrir")</a>
                                    @if (plan.Status != "finalized")
                                    {
                                        <button class="rp-btn rp-btn--primary rp-btn--sm" type="button" @onclick="() => AskFinalize(plan)">Finalizar</button>
                                    }
                                </td>
                            </tr>
                            @if (finalizeId == plan.Id)
                            {
                                <tr>
                                    <td colspan="6">
                                        <div class="rp-alert rp-alert--danger rp-confirm">
                                            <span>Depois de finalizado, o plano não poderá mais ser alterado. O procedimento operacional será congelado no plano.</span>
                                            <button class="rp-btn rp-btn--primary rp-btn--sm" type="button" @onclick="() => FinalizeAsync(plan)">Confirmar</button>
                                            <button class="rp-btn rp-btn--ghost rp-btn--sm" type="button" @onclick="CancelFinalize">Cancelar</button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        }
    </RpCard>
}

@code {
    private List<RiggingPlan> plans = [];
    private bool isLoading = true;
    private Guid? finalizeId;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadPlansAsync();
    }

    private async Task LoadPlansAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        plans = await db.RiggingPlans.AsNoTracking()
            .Where(plan => plan.DeletedAt == null)
            .OrderByDescending(plan => plan.PlanDate)
            .ThenByDescending(plan => plan.PlanNumber)
            .ToListAsync();
        isLoading = false;
    }

    private void AskFinalize(RiggingPlan plan) => finalizeId = plan.Id;
    private void CancelFinalize() => finalizeId = null;

    private async Task FinalizeAsync(RiggingPlan plan)
    {
        errorMessage = null;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            await using var transaction = await db.Database.BeginTransactionAsync();

            var stored = await db.RiggingPlans
                .Include(x => x.ProcedureSnapshot)
                .SingleOrDefaultAsync(x => x.Id == plan.Id && x.DeletedAt == null);

            if (stored is null || stored.Status == "finalized")
            {
                CancelFinalize();
                return;
            }

            var finalizedAt = DateTime.Now;
            stored.Status = "finalized";
            stored.FinalizedAt = finalizedAt;
            stored.UpdatedAt = finalizedAt;

            if (stored.ProcedureSnapshot is null)
            {
                db.PlanProcedureSnapshots.Add(
                    OperationalProcedureService.CreateSnapshot(stored, finalizedAt));
            }

            await db.SaveChangesAsync();
            await transaction.CommitAsync();

            CancelFinalize();
            await LoadPlansAsync();
        }
        catch (Exception exception)
        {
            errorMessage = $"Não foi possível finalizar o plano: {exception.Message}";
        }
    }
}
