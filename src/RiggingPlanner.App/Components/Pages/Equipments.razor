@page "/equipments"
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.Maui.Storage
@inject IDbContextFactory<AppDbContext> DbFactory

<RpPageHeader Title="Equipamentos" Subtitle="Cadastre os equipamentos e gerencie suas ARTs e laudos de conformidade" />

<div class="rp-stack">
    <RpCard Title="@(editingId is null ? "Novo equipamento (com ART inicial obrigatória)" : $"Editando equipamento - {form.CraneModel}")">
        @if (message is not null)
        {
            <div class="rp-alert @(isError ? "rp-alert--danger" : "rp-alert--success")">@message</div>
        }
        <EditForm Model="form" OnValidSubmit="SaveAsync">
            <DataAnnotationsValidator />
            <div class="rp-form-grid">
                <div class="rp-field rp-col-4"><label class="rp-label">Modelo do Guindaste <span class="rp-required-marker" aria-hidden="true">*</span></label><InputText class="rp-input" @bind-Value="form.CraneModel" /><ValidationMessage For="() => form.CraneModel" /></div>
                <div class="rp-field rp-col-4"><label class="rp-label">Caminhão <span class="rp-required-marker" aria-hidden="true">*</span></label><InputText class="rp-input" @bind-Value="form.TruckModel" /><ValidationMessage For="() => form.TruckModel" /></div>
                <div class="rp-field rp-col-4"><label class="rp-label">Chassi <span class="rp-required-marker" aria-hidden="true">*</span></label><InputText class="rp-input" @bind-Value="form.ChassisNumber" /><ValidationMessage For="() => form.ChassisNumber" /></div>
                <div class="rp-field rp-col-6"><label class="rp-label">Placas <span class="rp-required-marker" aria-hidden="true">*</span></label><InputText class="rp-input" @bind-Value="form.LicensePlate" /><ValidationMessage For="() => form.LicensePlate" /></div>
                <div class="rp-field rp-col-6"><label class="rp-label">Ano de fabricação <span class="rp-required-marker" aria-hidden="true">*</span></label><InputNumber class="rp-input rp-input--num" step="1" inputmode="numeric" @bind-Value="form.ManufactureYear" /><ValidationMessage For="() => form.ManufactureYear" /></div>
            </div>

            @if (editingId is null)
            {
                <div class="rp-card" style="margin-top: var(--rp-space-4); padding: var(--rp-space-4); background: var(--rp-surface-muted);">
                    <h3 class="rp-section-title" style="font-size: 1.05rem; margin-bottom: var(--rp-space-2);">ART Inicial Obrigatória</h3>
                    <p class="rp-help" style="margin-bottom: var(--rp-space-3);">Todo equipamento precisa de pelo menos uma ART válida com anexo PDF para ser cadastrado.</p>
                    <div class="rp-form-grid">
                        <div class="rp-field rp-col-4">
                            <label class="rp-label" for="new-art-number">Número da ART <span class="rp-required-marker" aria-hidden="true">*</span></label>
                            <InputText id="new-art-number" class="rp-input" @bind-Value="initialArtNumber" placeholder="Ex: 2026/123456" />
                        </div>
                        <div class="rp-field rp-col-4">
                            <label class="rp-label" for="new-art-from">Data de início</label>
                            <InputDate id="new-art-from" class="rp-input" @bind-Value="initialArtValidFrom" />
                        </div>
                        <div class="rp-field rp-col-4">
                            <label class="rp-label" for="new-art-to">Previsão de término</label>
                            <InputDate id="new-art-to" class="rp-input" @bind-Value="initialArtValidTo" />
                        </div>
                        <div class="rp-field rp-col-12">
                            <label class="rp-label" for="new-art-file">Anexo PDF da ART <span class="rp-required-marker" aria-hidden="true">*</span></label>
                            <InputFile id="new-art-file" class="rp-file-input" OnChange="OnInitialFileChange" accept=".pdf,application/pdf" />
                            <label class="rp-btn rp-btn--ghost rp-file-button" for="new-art-file">
                                <svg class="rp-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M12 16V4m0 0-4 4m4-4 4 4M5 14v4a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-4" />
                                </svg>
                                @(initialArtFile is not null ? "Arquivo selecionado: " + initialArtFile.Name : "Escolher arquivo PDF")
                            </label>
                            <span class="rp-help">@(initialArtFile?.Name ?? "Nenhum arquivo PDF selecionado")</span>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="rp-card" style="margin-top: var(--rp-space-4); padding: var(--rp-space-4); background: var(--rp-surface-muted); display: flex; align-items: center; justify-content: space-between; gap: var(--rp-space-4);">
                    <div>
                        <h3 class="rp-section-title" style="font-size: 1rem; margin-bottom: var(--rp-space-1);">Gestão de ARTs e Laudos</h3>
                        <p class="rp-help">Para adicionar novas ARTs, substituir arquivos ou gerenciar o histórico deste equipamento, utilize o gerenciador dedicado.</p>
                    </div>
                    <button class="rp-btn rp-btn--ghost" type="button" @onclick="OpenArtModalForEditing">
                        Gerenciar ARTs deste equipamento
                    </button>
                </div>
            }

            <div class="rp-form-actions" style="margin-top: var(--rp-space-4);">
                <button class="rp-btn rp-btn--primary" type="submit" disabled="@isSaving">@(editingId is null ? "Cadastrar equipamento" : "Salvar alterações do equipamento")</button>
                @if (editingId is not null)
                {
                    <button class="rp-btn rp-btn--ghost" type="button" @onclick="CancelEdit">Cancelar</button>
                }
            </div>
        </EditForm>
    </RpCard>

    <RpCard Title="Equipamentos ativos">
        <p class="rp-help" style="margin-bottom: var(--rp-space-3);">Clique no status da ART na tabela para gerenciar, adicionar ou substituir documentos PDF instantaneamente.</p>
        <div class="rp-table-wrap">
            <table class="rp-table">
                <thead>
                    <tr><th>Modelo</th><th>Caminhão</th><th>Chassi</th><th>Placas</th><th>Ano</th><th>ARTs (Clique para gerenciar)</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var equipment in activeEquipments)
                    {
                        <tr>
                            <td>@equipment.CraneModel</td>
                            <td>@equipment.TruckModel</td>
                            <td>@equipment.ChassisNumber</td>
                            <td>@equipment.LicensePlate</td>
                            <td>@(equipment.ManufactureYear?.ToString() ?? "-")</td>
                            <td>
                                <button class="rp-btn rp-btn--ghost rp-btn--sm" type="button" @onclick="() => OpenArtModal(equipment)" title="Gerenciar ARTs deste equipamento">
                                    @RenderArtSummary(equipment)
                                </button>
                            </td>
                            <td class="rp-row-actions">
                                <button class="rp-btn rp-btn--ghost rp-btn--sm" type="button" @onclick="() => BeginEditAsync(equipment)">Editar</button>
                                <button class="rp-btn rp-btn--ghost rp-btn--sm" type="button" @onclick="() => ToggleStatusAsync(equipment)">Inativar</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </RpCard>

    @if (message is not null) { <div class="rp-alert rp-alert--danger">@message</div> }
    <RpInactiveSection TItem="Equipment"
                       Title="Equipamentos inativos"
                       Description="Equipamentos inativos não podem ser selecionados em novos planos."
                       EmptyText="Nenhum equipamento inativo."
                       Items="inactiveEquipments">
        <HeaderTemplate><th>Modelo</th><th>Caminhão</th><th>Chassi</th><th>Placas</th><th></th></HeaderTemplate>
        <RowTemplate Context="equipment">
                <tr class="rp-row--inactive">
                    <td>@equipment.CraneModel</td>
                    <td>@equipment.TruckModel</td>
                    <td>@equipment.ChassisNumber</td>
                    <td>@equipment.LicensePlate</td>
                    <td class="rp-row-actions">
                        <button class="rp-btn rp-btn--ghost rp-btn--sm" @onclick="() => ToggleStatusAsync(equipment)">Reativar</button>
                        <button class="rp-btn rp-btn--danger-outline rp-btn--sm" disabled="@(deleteId == equipment.Id)" @onclick="() => AskDelete(equipment)">Excluir definitivamente</button>
                    </td>
                </tr>
                @if (deleteId == equipment.Id)
                {
                    <tr class="rp-row--inactive">
                        <td colspan="5">
                            <div class="rp-alert rp-alert--danger rp-confirm">
                                <span>Você está prestes a excluir este equipamento permanentemente. Essa informação não poderá ser recuperada. Planos já finalizados continuam preservando os dados históricos; planos em andamento impedem a exclusão.</span>
                                <button class="rp-btn rp-btn--danger rp-btn--sm" @onclick="DeleteAsync">Excluir definitivamente</button>
                                <button class="rp-btn rp-btn--ghost rp-btn--sm" @onclick="CancelDelete">Cancelar</button>
                            </div>
                        </td>
                    </tr>
                }
        </RowTemplate>
    </RpInactiveSection>
</div>

<RpEquipmentArtModal IsOpen="isArtModalOpen" Equipment="artModalEquipment" OnClose="CloseArtModalAsync" OnChanged="LoadAsync" />

@code {
    private List<Equipment> activeEquipments = [];
    private List<Equipment> inactiveEquipments = [];
    private EquipmentForm form = new();
    private Guid? editingId;
    private bool isSaving;
    private Guid? deleteId;
    private string? message;
    private bool isError;
    private bool isArtModalOpen;
    private Equipment? artModalEquipment;

    // Initial ART fields for new equipment creation
    private string initialArtNumber = string.Empty;
    private DateTime? initialArtValidFrom;
    private DateTime? initialArtValidTo;
    private IBrowserFile? initialArtFile;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        activeEquipments = await db.Equipments.AsNoTracking().Include(x => x.Reports).Where(x => x.IsActive).OrderBy(x => x.CraneModel).ToListAsync();
        inactiveEquipments = await db.Equipments.AsNoTracking().Include(x => x.Reports).Where(x => !x.IsActive).OrderBy(x => x.CraneModel).ToListAsync();
    }

    private async Task OnInitialFileChange(InputFileChangeEventArgs args)
    {
        if (!string.Equals(Path.GetExtension(args.File.Name), ".pdf", StringComparison.OrdinalIgnoreCase))
        {
            initialArtFile = null;
            message = "Anexe somente arquivos PDF para a ART.";
            isError = true;
            return;
        }

        initialArtFile = args.File;
        message = null;
        isError = false;
        await Task.CompletedTask;
    }

    private async Task SaveAsync()
    {
        message = null;
        isError = false;

        if (editingId is null)
        {
            if (string.IsNullOrWhiteSpace(initialArtNumber))
            {
                message = "Informe o número da ART inicial.";
                isError = true;
                return;
            }
            if (initialArtFile is null)
            {
                message = "Anexe o arquivo PDF da ART inicial.";
                isError = true;
                return;
            }
            if (initialArtValidFrom is not null && initialArtValidTo is not null && initialArtValidTo < initialArtValidFrom)
            {
                message = "A previsão de término da ART deve ser posterior à data de início.";
                isError = true;
                return;
            }
        }

        isSaving = true;
        await using var db = await DbFactory.CreateDbContextAsync();
        var stored = editingId is null ? null : await db.Equipments.Include(x => x.Reports).SingleOrDefaultAsync(x => x.Id == editingId);
        if (editingId is not null && stored is null)
        {
            message = "O equipamento não foi encontrado.";
            isError = true;
            isSaving = false;
            return;
        }

        stored ??= new Equipment { Id = Guid.NewGuid(), IsActive = true, CreatedAt = DateTime.Now };
        stored.EquipmentType = "munck";
        stored.TruckModel = form.TruckModel.Trim();
        stored.LicensePlate = form.LicensePlate.Trim().ToUpperInvariant();
        stored.ChassisNumber = form.ChassisNumber.Trim();
        stored.ManufactureYear = form.ManufactureYear;
        stored.CraneBrand = string.Empty;
        stored.CraneModel = form.CraneModel.Trim();
        stored.UpdatedAt = DateTime.Now;

        if (editingId is null)
        {
            db.Equipments.Add(stored);
            var file = await SaveFileAsync(initialArtFile!);
            db.StoredFiles.Add(file);
            db.EquipmentReports.Add(new EquipmentReport
            {
                Id = Guid.NewGuid(),
                EquipmentId = stored.Id,
                FileId = file.Id,
                ArtNumber = initialArtNumber.Trim(),
                ValidFrom = initialArtValidFrom,
                ValidTo = initialArtValidTo,
                CreatedAt = DateTime.Now
            });
        }

        await db.SaveChangesAsync();
        var wasEditing = editingId is not null;
        
        form = new();
        initialArtNumber = string.Empty;
        initialArtValidFrom = null;
        initialArtValidTo = null;
        initialArtFile = null;
        editingId = null;

        message = wasEditing ? "Equipamento atualizado com sucesso." : "Equipamento e ART inicial cadastrados com sucesso.";
        isSaving = false;
        await LoadAsync();
    }

    private async Task BeginEditAsync(Equipment equipment)
    {
        editingId = equipment.Id;
        form = new()
        {
            CraneModel = equipment.CraneModel,
            TruckModel = equipment.TruckModel,
            ChassisNumber = equipment.ChassisNumber,
            LicensePlate = equipment.LicensePlate,
            ManufactureYear = equipment.ManufactureYear
        };
        message = null;
        isError = false;
    }

    private void CancelEdit()
    {
        editingId = null;
        form = new();
        initialArtNumber = string.Empty;
        initialArtValidFrom = null;
        initialArtValidTo = null;
        initialArtFile = null;
        message = null;
        isError = false;
    }

    private static bool IsReportCurrent(EquipmentReport report) =>
        report.ValidTo is null || report.ValidTo.Value.Date >= DateTime.Today;

    private RenderFragment RenderArtSummary(Equipment equipment) => builder =>
    {
        var count = equipment.Reports.Count;
        if (count == 0)
        {
            builder.AddContent(0, new MarkupString("<span class=\"rp-badge rp-badge--muted\">Sem ARTs - Clique para adicionar</span>"));
            return;
        }

        var currentCount = equipment.Reports.Count(IsReportCurrent);
        var latest = equipment.Reports.OrderByDescending(x => IsReportCurrent(x)).ThenByDescending(x => x.ValidFrom).FirstOrDefault();

        builder.OpenElement(1, "span");
        builder.AddAttribute(2, "class", $"rp-badge {(currentCount > 0 ? "rp-badge--success" : "rp-badge--muted")}");
        builder.AddContent(3, $"{count} ART{(count == 1 ? string.Empty : "s")} ({currentCount} válida{(currentCount == 1 ? string.Empty : "s")}) - {latest?.ArtNumber}");
        builder.CloseElement();
    };

    private void OpenArtModal(Equipment equipment)
    {
        artModalEquipment = equipment;
        isArtModalOpen = true;
    }

    private void OpenArtModalForEditing()
    {
        if (editingId is null) return;
        var equipment = activeEquipments.Concat(inactiveEquipments).FirstOrDefault(x => x.Id == editingId.Value);
        if (equipment is not null)
        {
            OpenArtModal(equipment);
        }
    }

    private async Task CloseArtModalAsync()
    {
        isArtModalOpen = false;
        artModalEquipment = null;
        await LoadAsync();
    }

    private static async Task<StoredFile> SaveFileAsync(IBrowserFile browserFile)
    {
        var fileId = Guid.NewGuid();
        var extension = Path.GetExtension(browserFile.Name);
        var folder = Path.Combine(FileSystem.AppDataDirectory, "equipment-art");
        Directory.CreateDirectory(folder);
        var relativePath = Path.Combine("equipment-art", fileId + extension);
        var absolutePath = Path.Combine(FileSystem.AppDataDirectory, relativePath);
        await using var input = browserFile.OpenReadStream(10 * 1024 * 1024);
        await using var output = File.Create(absolutePath);
        using var sha = System.Security.Cryptography.SHA256.Create();
        var buffer = new byte[81920];
        int read;
        long size = 0;
        while ((read = await input.ReadAsync(buffer)) > 0)
        {
            await output.WriteAsync(buffer.AsMemory(0, read));
            sha.TransformBlock(buffer, 0, read, null, 0);
            size += read;
        }
        sha.TransformFinalBlock([], 0, 0);
        return new StoredFile
        {
            Id = fileId,
            RelativePath = relativePath,
            OriginalName = browserFile.Name,
            ContentType = browserFile.ContentType,
            SizeBytes = size,
            Sha256 = Convert.ToHexString(sha.Hash!).ToLowerInvariant(),
            CreatedAt = DateTime.Now
        };
    }

    private async Task ToggleStatusAsync(Equipment equipment)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var stored = await db.Equipments.FindAsync(equipment.Id);
        if (stored is null) return;
        stored.IsActive = !stored.IsActive;
        stored.UpdatedAt = DateTime.Now;
        await db.SaveChangesAsync();
        await LoadAsync();
    }

    private void AskDelete(Equipment equipment) => deleteId = equipment.Id;
    private void CancelDelete() => deleteId = null;

    private async Task DeleteAsync()
    {
        if (deleteId is null) return;
        await using var db = await DbFactory.CreateDbContextAsync();
        var equipment = await db.Equipments.FindAsync(deleteId.Value);
        if (equipment is null) { CancelDelete(); return; }
        var inProgressUse = await db.RiggingPlans.AnyAsync(x => x.EquipmentId == equipment.Id
            && x.DeletedAt == null && x.Status != "finalized");
        if (inProgressUse)
        {
            message = "Não é possível excluir: o equipamento está ligado a um plano em andamento.";
            CancelDelete();
            return;
        }
        db.Equipments.Remove(equipment);
        await db.SaveChangesAsync();
        message = null;
        CancelDelete();
        await LoadAsync();
    }

    private sealed class EquipmentForm
    {
        [Required(ErrorMessage = "Informe o caminhão.")] public string TruckModel { get; set; } = string.Empty;
        [Required(ErrorMessage = "Informe a placa.")] public string LicensePlate { get; set; } = string.Empty;
        [Required(ErrorMessage = "Informe o chassi.")] public string ChassisNumber { get; set; } = string.Empty;
        [Required(ErrorMessage = "Informe o ano de fabricação.")] public int? ManufactureYear { get; set; }
        [Required(ErrorMessage = "Informe o modelo.")] public string CraneModel { get; set; } = string.Empty;
    }
}
