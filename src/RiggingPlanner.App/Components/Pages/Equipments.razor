@page "/equipments"
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.Maui.Storage
@inject IDbContextFactory<AppDbContext> DbFactory

<RpPageHeader Title="Equipamentos" Subtitle="Cadastre os equipamentos para reaproveitar nos planos de rigging" />

<div class="rp-stack">
    <RpCard Title="@(editingId is null ? "Novo equipamento" : "Editar equipamento")">
        @if (message is not null)
        {
            <div class="rp-alert @(isError ? "rp-alert--danger" : "rp-alert--success")">@message</div>
        }
        <EditForm Model="form" OnValidSubmit="SaveAsync">
            <DataAnnotationsValidator />
            <div class="rp-form-grid">
                <div class="rp-field rp-col-4"><label class="rp-label">Modelo <span class="rp-required-marker" aria-hidden="true">*</span></label><InputText class="rp-input" @bind-Value="form.CraneModel" /><ValidationMessage For="() => form.CraneModel" /></div>
                <div class="rp-field rp-col-4"><label class="rp-label">Caminhão <span class="rp-required-marker" aria-hidden="true">*</span></label><InputText class="rp-input" @bind-Value="form.TruckModel" /><ValidationMessage For="() => form.TruckModel" /></div>
                <div class="rp-field rp-col-4"><label class="rp-label">Chassi <span class="rp-required-marker" aria-hidden="true">*</span></label><InputText class="rp-input" @bind-Value="form.ChassisNumber" /><ValidationMessage For="() => form.ChassisNumber" /></div>
                <div class="rp-field rp-col-4"><label class="rp-label">Placas <span class="rp-required-marker" aria-hidden="true">*</span></label><InputText class="rp-input" @bind-Value="form.LicensePlate" /><ValidationMessage For="() => form.LicensePlate" /></div>
                <div class="rp-field rp-col-4"><label class="rp-label">Ano de fabricação <span class="rp-required-marker" aria-hidden="true">*</span></label><InputNumber class="rp-input rp-input--num" step="1" inputmode="numeric" @bind-Value="form.ManufactureYear" /><ValidationMessage For="() => form.ManufactureYear" /></div>
            </div>
            <RpEquipmentArtEditor Items="artItems" />
            <div class="rp-form-actions">
                <button class="rp-btn rp-btn--primary" type="submit" disabled="@isSaving">@(editingId is null ? "Cadastrar equipamento" : "Salvar equipamento")</button>
                @if (editingId is not null)
                {
                    <button class="rp-btn rp-btn--ghost" type="button" @onclick="CancelEdit">Cancelar</button>
                }
            </div>
        </EditForm>
    </RpCard>
    <RpCard Title="Equipamentos ativos">
        <div class="rp-table-wrap"><table class="rp-table"><thead><tr><th>Modelo</th><th>Caminhão</th><th>Chassi</th><th>Placas</th><th>Ano</th><th>ART</th><th></th></tr></thead><tbody>
            @foreach (var equipment in activeEquipments)
            {
                <tr><td>@equipment.CraneModel</td><td>@equipment.TruckModel</td><td>@equipment.ChassisNumber</td><td>@equipment.LicensePlate</td><td>@(equipment.ManufactureYear?.ToString() ?? "-")</td><td>@RenderArtStatus(equipment)</td><td class="rp-row-actions"><button class="rp-btn rp-btn--ghost rp-btn--sm" @onclick="() => BeginEditAsync(equipment)">Editar</button> <button class="rp-btn rp-btn--ghost rp-btn--sm" @onclick="() => ToggleStatusAsync(equipment)">Inativar</button></td></tr>
            }
        </tbody></table></div>
    </RpCard>
    @if (message is not null) { <div class="rp-alert rp-alert--danger">@message</div> }
    <RpInactiveSection TItem="Equipment"
                       Title="Equipamentos inativos"
                       Description="Equipamentos inativos não podem ser selecionados em novos planos."
                       EmptyText="Nenhum equipamento inativo."
                       Items="inactiveEquipments">
        <HeaderTemplate><th>Modelo</th><th>Caminhão</th><th>Chassi</th><th>Placas</th><th></th></HeaderTemplate>
        <RowTemplate Context="equipment">
                <tr class="rp-row--inactive"><td>@equipment.CraneModel</td><td>@equipment.TruckModel</td><td>@equipment.ChassisNumber</td><td>@equipment.LicensePlate</td><td class="rp-row-actions"><button class="rp-btn rp-btn--ghost rp-btn--sm" @onclick="() => ToggleStatusAsync(equipment)">Reativar</button> <button class="rp-btn rp-btn--danger-outline rp-btn--sm" disabled="@(deleteId == equipment.Id)" @onclick="() => AskDelete(equipment)">Excluir definitivamente</button></td></tr>
                @if (deleteId == equipment.Id)
                {
                    <tr class="rp-row--inactive"><td colspan="5"><div class="rp-alert rp-alert--danger rp-confirm"><span>Você está prestes a excluir este equipamento permanentemente. Essa informação não poderá ser recuperada. Planos já finalizados continuam preservando os dados históricos; planos em andamento impedem a exclusão.</span><button class="rp-btn rp-btn--danger rp-btn--sm" @onclick="DeleteAsync">Excluir definitivamente</button><button class="rp-btn rp-btn--ghost rp-btn--sm" @onclick="CancelDelete">Cancelar</button></div></td></tr>
            }
        </RowTemplate>
    </RpInactiveSection>
</div>

@code {
    private List<Equipment> activeEquipments = [];
    private List<Equipment> inactiveEquipments = [];
    private EquipmentForm form = new();
    private List<EquipmentArtDraft> artItems = [];
    private Guid? editingId;
    private bool isSaving;
    private Guid? deleteId;
    private string? message;
    private bool isError;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        activeEquipments = await db.Equipments.AsNoTracking().Include(x => x.Reports).Where(x => x.IsActive).OrderBy(x => x.CraneModel).ToListAsync();
        inactiveEquipments = await db.Equipments.AsNoTracking().Include(x => x.Reports).Where(x => !x.IsActive).OrderBy(x => x.CraneModel).ToListAsync();
    }

    private async Task SaveAsync()
    {
        isSaving = true;
        message = null;
        isError = false;
        await using var db = await DbFactory.CreateDbContextAsync();
        var stored = editingId is null ? null : await db.Equipments.Include(x => x.Reports).SingleOrDefaultAsync(x => x.Id == editingId);
        if (editingId is not null && stored is null)
        {
            message = "O equipamento não foi encontrado.";
            isError = true;
            isSaving = false;
            return;
        }

        stored ??= new Equipment { Id = Guid.NewGuid(), IsActive = true, CreatedAt = DateTime.Now };
        stored.EquipmentType = "munck";
        stored.TruckModel = form.TruckModel.Trim();
        stored.LicensePlate = form.LicensePlate.Trim().ToUpperInvariant();
        stored.ChassisNumber = form.ChassisNumber.Trim();
        stored.ManufactureYear = form.ManufactureYear;
        stored.CraneBrand = string.Empty;
        stored.CraneModel = form.CraneModel.Trim();
        stored.NominalCapacity = null;
        stored.UpdatedAt = DateTime.Now;
        if (editingId is null) db.Equipments.Add(stored);

        await db.SaveChangesAsync();
        var wasEditing = editingId is not null;
        editingId = stored.Id;
        try
        {
            await SaveArtsAsync(db, stored);
            await db.SaveChangesAsync();
        }
        catch (InvalidOperationException exception)
        {
            message = exception.Message;
            isError = true;
            isSaving = false;
            return;
        }
        form = new();
        artItems = [];
        message = wasEditing ? "Equipamento e ARTs atualizados com sucesso." : "Equipamento cadastrado com sucesso.";
        isSaving = false;
        await LoadAsync();
    }

    private async Task BeginEditAsync(Equipment equipment)
    {
        editingId = equipment.Id;
        await LoadArtItemsAsync(equipment.Id);
        form = new()
        {
            CraneModel = equipment.CraneModel, TruckModel = equipment.TruckModel,
            ChassisNumber = equipment.ChassisNumber, LicensePlate = equipment.LicensePlate,
            ManufactureYear = equipment.ManufactureYear
        };
        message = null;
        isError = false;
    }

    private void CancelEdit()
    {
        editingId = null;
        form = new();
        artItems = [];
        message = null;
        isError = false;
    }

    private static bool IsReportCurrent(EquipmentReport report) =>
        report.ValidTo is null || report.ValidTo.Value.Date >= DateTime.Today;

    private async Task LoadArtItemsAsync(Guid equipmentId)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        artItems = await db.EquipmentReports
            .AsNoTracking()
            .Include(x => x.File)
            .Where(x => x.EquipmentId == equipmentId)
            .OrderByDescending(x => x.ValidFrom)
            .Select(x => new EquipmentArtDraft
            {
                Id = x.Id,
                ArtNumber = x.ArtNumber,
                ValidFrom = x.ValidFrom,
                ValidTo = x.ValidTo,
                ExistingFileName = x.File.OriginalName
            })
            .ToListAsync();
    }

    private async Task SaveArtsAsync(AppDbContext db, Equipment equipment)
    {
        var existingReports = await db.EquipmentReports
            .Include(x => x.File)
            .Where(x => x.EquipmentId == equipment.Id)
            .ToListAsync();
        var incomingIds = artItems.Where(x => x.Id is not null).Select(x => x.Id!.Value).ToHashSet();
        var removedReports = existingReports.Where(x => !incomingIds.Contains(x.Id)).ToList();

        foreach (var report in removedReports)
        {
            if (await db.RiggingPlans.AnyAsync(x => x.EquipmentReportId == report.Id && x.DeletedAt == null))
            {
                throw new InvalidOperationException($"A ART {report.ArtNumber} está vinculada a um plano e não pode ser excluída.");
            }

            db.EquipmentReports.Remove(report);
            if (report.File is not null) db.StoredFiles.Remove(report.File);
        }

        foreach (var item in artItems)
        {
            if (item.Id is null)
            {
                if (item.File is null) throw new InvalidOperationException($"A ART {item.ArtNumber} está sem anexo.");
                EnsurePdf(item.File, item.ArtNumber);
                var file = await SaveFileAsync(item.File);
                db.StoredFiles.Add(file);
                db.EquipmentReports.Add(new EquipmentReport
                {
                    Id = Guid.NewGuid(),
                    EquipmentId = equipment.Id,
                    FileId = file.Id,
                    ArtNumber = item.ArtNumber.Trim(),
                    ValidFrom = item.ValidFrom,
                    ValidTo = item.ValidTo,
                    CreatedAt = DateTime.Now
                });
                continue;
            }

            var report = existingReports.SingleOrDefault(x => x.Id == item.Id.Value);
            if (report is null) throw new InvalidOperationException("Uma das ARTs informadas não foi encontrada.");
            report.ArtNumber = item.ArtNumber.Trim();
            report.ValidFrom = item.ValidFrom;
            report.ValidTo = item.ValidTo;
            if (item.File is not null)
            {
                EnsurePdf(item.File, item.ArtNumber);
                var oldFile = report.File;
                var file = await SaveFileAsync(item.File);
                report.FileId = file.Id;
                db.StoredFiles.Add(file);
                if (oldFile is not null) db.StoredFiles.Remove(oldFile);
            }
        }

    }

    private static void EnsurePdf(IBrowserFile file, string artNumber)
    {
        if (!string.Equals(Path.GetExtension(file.Name), ".pdf", StringComparison.OrdinalIgnoreCase))
        {
            throw new InvalidOperationException($"A ART {artNumber} deve ter um anexo PDF.");
        }
    }

    private RenderFragment RenderArtStatus(Equipment equipment) => builder =>
    {
        var report = equipment.Reports
            .OrderByDescending(x => IsReportCurrent(x))
            .ThenByDescending(x => x.ValidFrom)
            .FirstOrDefault();
        if (report is null)
        {
            builder.AddContent(0, new MarkupString("<span class=\"rp-badge rp-badge--muted\">Sem ART</span>"));
            return;
        }

        builder.OpenElement(1, "span");
        builder.AddAttribute(2, "class", $"rp-badge {(IsReportCurrent(report) ? "rp-badge--success" : "rp-badge--muted")}");
        builder.AddContent(3, $"{report.ArtNumber} — {(IsReportCurrent(report) ? "Válida" : "Vencida")}");
        builder.CloseElement();
    };

    private static async Task<StoredFile> SaveFileAsync(IBrowserFile browserFile)
    {
        var fileId = Guid.NewGuid();
        var extension = Path.GetExtension(browserFile.Name);
        var folder = Path.Combine(FileSystem.AppDataDirectory, "equipment-art");
        Directory.CreateDirectory(folder);
        var relativePath = Path.Combine("equipment-art", fileId + extension);
        var absolutePath = Path.Combine(FileSystem.AppDataDirectory, relativePath);
        await using var input = browserFile.OpenReadStream(10 * 1024 * 1024);
        await using var output = File.Create(absolutePath);
        using var sha = System.Security.Cryptography.SHA256.Create();
        var buffer = new byte[81920];
        int read;
        long size = 0;
        while ((read = await input.ReadAsync(buffer)) > 0)
        {
            await output.WriteAsync(buffer.AsMemory(0, read));
            sha.TransformBlock(buffer, 0, read, null, 0);
            size += read;
        }
        sha.TransformFinalBlock([], 0, 0);
        return new StoredFile
        {
            Id = fileId, RelativePath = relativePath, OriginalName = browserFile.Name,
            ContentType = browserFile.ContentType, SizeBytes = size,
            Sha256 = Convert.ToHexString(sha.Hash!).ToLowerInvariant(), CreatedAt = DateTime.Now
        };
    }

    private async Task ToggleStatusAsync(Equipment equipment)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var stored = await db.Equipments.FindAsync(equipment.Id);
        if (stored is null) return;
        stored.IsActive = !stored.IsActive;
        stored.UpdatedAt = DateTime.Now;
        await db.SaveChangesAsync();
        await LoadAsync();
    }

    private void AskDelete(Equipment equipment) => deleteId = equipment.Id;
    private void CancelDelete() => deleteId = null;

    private async Task DeleteAsync()
    {
        if (deleteId is null) return;
        await using var db = await DbFactory.CreateDbContextAsync();
        var equipment = await db.Equipments.FindAsync(deleteId.Value);
        if (equipment is null) { CancelDelete(); return; }
        var inProgressUse = await db.RiggingPlans.AnyAsync(x => x.EquipmentId == equipment.Id
            && x.DeletedAt == null && x.Status != "finalized");
        if (inProgressUse)
        {
            message = "Não é possível excluir: o equipamento está ligado a um plano em andamento.";
            CancelDelete();
            return;
        }
        db.Equipments.Remove(equipment);
        await db.SaveChangesAsync();
        message = null;
        CancelDelete();
        await LoadAsync();
    }

    private sealed class EquipmentForm
    {
        [Required(ErrorMessage = "Informe o caminhão.")] public string TruckModel { get; set; } = string.Empty;
        [Required(ErrorMessage = "Informe a placa.")] public string LicensePlate { get; set; } = string.Empty;
        [Required(ErrorMessage = "Informe o chassi.")] public string ChassisNumber { get; set; } = string.Empty;
        [Required(ErrorMessage = "Informe o ano de fabricação.")] public int? ManufactureYear { get; set; }
        [Required(ErrorMessage = "Informe o modelo.")] public string CraneModel { get; set; } = string.Empty;
    }
}
