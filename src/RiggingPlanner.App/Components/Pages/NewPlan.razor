@page "/new-plan"
@page "/new-plan/{PlanId:guid}"
@using Microsoft.AspNetCore.Components
@using Microsoft.JSInterop
@inject IDbContextFactory<AppDbContext> DbFactory
@inject NavigationManager Navigation
@inject IJSRuntime JS

<RpPageHeader
    Title="@PageTitle"
    Subtitle="Dados de entrada — Preencha os dados sem perder informações entre as etapas">
    <Actions>
        <RpPlanActions IsNew="@(PlanId is null || isDraftPlan)" IsReadOnly="@isReadOnly" IsSaving="@isSaving"
                       Save="SaveFormAsync" Discard="AskDiscard" />
    </Actions>
</RpPageHeader>

<RpPlanLeaveGuard PlanId="@WorkflowPlanId" IsReadOnly="@isReadOnly" IsSaving="@isSaving" />

<div class="rp-stack">
    <RpStepper Steps="steps" Links="stepLinks" Current="0" />
    <RpPlanNavigation PreviousUrl="@null" NextUrl="@($"new-plan/{WorkflowPlanId}/capacity")" />
    <RpPlanInputForm Model="form" IsReadOnly="isReadOnly" IsSaving="isSaving" ErrorMessage="@errorMessage"
                     ErrorMessageChanged="@(e => errorMessage = e)"
                     EquipmentOptions="equipmentOptions" EquipmentSuggestions="EquipmentSuggestions" SelectedEquipment="SelectedEquipment"
                     IsNewEquipmentSelected="isNewEquipmentSelected" IsExistingEquipment="IsExistingEquipment" HasExactEquipment="HasExactEquipment"
                     OnEquipmentModelInput="OnEquipmentModelInput" OnEquipmentSelect="SelectEquipment"
                     OnEquipmentCreate="CreateEquipmentFromInput" OnEquipmentRemove="RemoveSelectedEquipment"
                     RiggerOptions="riggerOptions" ClientSuggestions="ClientSuggestions" SelectedClient="SelectedClient"
                     IsNewClientSelected="isNewClientSelected" IsExistingClient="IsExistingClient" HasExactClient="HasExactClient"
                     OnValidSubmit="SaveAsync" OnClientNameInput="OnClientNameInput" OnClientSelect="SelectClient"
                     OnClientCreate="CreateClientFromInput" OnClientRemove="RemoveSelectedClient"
                     OnClientCnpjInput="OnClientCnpjInput" RiggerSuggestions="RiggerSuggestions" SelectedRigger="SelectedRigger"
                     IsNewRiggerSelected="isNewRiggerSelected" IsExistingRigger="IsExistingRigger" HasExactRigger="HasExactRigger"
                     OnRiggerNameInput="OnRiggerNameInput" OnRiggerSelect="SelectRigger" OnRiggerCreate="CreateRiggerFromInput"
                     OnRiggerRemove="RemoveSelectedRigger" @ref="inputForm" />
</div>

@code {
    private readonly string[] steps = ["Dados de entrada", "Capacidade de Carga", "Anexos", "Preview", "Exportação"];
    [Parameter] public Guid? PlanId { get; set; }
    [SupplyParameterFromQuery(Name = "save")]
    public bool SaveRequested { get; set; }
    [Inject] private PlanDraftState Draft { get; set; } = null!;
    private PlanFormModel form => Draft.Form;
    private RpPlanInputForm? inputForm;
    private IReadOnlyList<string> stepLinks =>
        [$"new-plan{(PlanId is null ? string.Empty : $"/{WorkflowPlanId}")}",
         $"new-plan/{WorkflowPlanId}/capacity", $"new-plan/{WorkflowPlanId}/attachments",
         $"new-plan/{WorkflowPlanId}/preview", $"new-plan/{WorkflowPlanId}/export"];
    private List<Equipment> equipmentOptions = [];
    private List<Rigger> riggerOptions = [];
    private List<Client> clientOptions = [];
    private bool isSaving;
    private bool isReadOnly;
    private bool isDraftPlan;
    private RiggingPlan? plan;
    private string PageTitle => Draft.GetPageTitle(plan);
    private string? errorMessage;
    private Client? SelectedClient => clientOptions.FirstOrDefault(x => x.Id == form.ClientId);
    private Rigger? SelectedRigger => riggerOptions.FirstOrDefault(x => x.Id == form.RiggerId);
    private Equipment? SelectedEquipment => equipmentOptions.FirstOrDefault(x => x.Id == form.EquipmentId);
    private bool IsExistingClient => form.ClientId is not null;
    private bool IsExistingRigger => form.RiggerId is not null;
    private bool IsExistingEquipment => form.EquipmentId is not null;
    private bool HasExactClient => clientOptions.Any(x => string.Equals(x.Name, form.ClientName?.Trim(),
        StringComparison.CurrentCultureIgnoreCase));
    private bool HasExactRigger => riggerOptions.Any(x => string.Equals(x.DisplayName, form.RiggerDisplayName?.Trim(),
        StringComparison.CurrentCultureIgnoreCase));
    private bool HasExactEquipment => equipmentOptions.Any(x => string.Equals(x.CraneModel, form.EquipmentModel?.Trim(),
        StringComparison.CurrentCultureIgnoreCase));
    private List<Client> ClientSuggestions => string.IsNullOrWhiteSpace(form.ClientName)
        ? []
        : clientOptions.Where(x => x.Name.Contains(form.ClientName.Trim(),
            StringComparison.CurrentCultureIgnoreCase)).Take(8).ToList();
    private List<Rigger> RiggerSuggestions => string.IsNullOrWhiteSpace(form.RiggerDisplayName)
        ? []
        : riggerOptions.Where(x => x.DisplayName.Contains(form.RiggerDisplayName.Trim(),
            StringComparison.CurrentCultureIgnoreCase)).Take(8).ToList();
    private List<Equipment> EquipmentSuggestions => string.IsNullOrWhiteSpace(form.EquipmentModel)
        ? []
        : equipmentOptions.Where(x => x.CraneModel.Contains(form.EquipmentModel.Trim(),
            StringComparison.CurrentCultureIgnoreCase)).Take(8).ToList();
    private bool isNewClientSelected;
    private bool isNewRiggerSelected;
    private bool isNewEquipmentSelected;

    private Guid WorkflowPlanId => PlanId ?? Draft.PlanId ?? Guid.Empty;
    private Task SaveFormAsync() => inputForm?.SubmitAsync() ?? Task.CompletedTask;
    private void AskDiscard() => DiscardChanges();
    private void DiscardChanges()
    {
        Draft.Reset();
        Draft.SuppressLeaveConfirmation = true;
        Navigation.NavigateTo("/");
    }

    private async Task<Equipment?> ResolveEquipmentAsync(AppDbContext db)
    {
        if (form.EquipmentId is not null)
        {
            return await db.Equipments.SingleOrDefaultAsync(x => x.Id == form.EquipmentId);
        }

        if (string.IsNullOrWhiteSpace(form.EquipmentModel))
        {
            return null;
        }

        var existing = await db.Equipments.SingleOrDefaultAsync(x => x.CraneModel.ToLower() == form.EquipmentModel.Trim().ToLower());
        if (existing is not null)
        {
            form.EquipmentId = existing.Id;
            return existing;
        }

        var equipment = new Equipment
        {
            Id = Guid.NewGuid(),
            CraneModel = form.EquipmentModel.Trim(),
            TruckModel = form.EquipmentTruckModel.Trim(),
            ChassisNumber = form.EquipmentChassisNumber.Trim(),
            LicensePlate = form.EquipmentLicensePlate.Trim().ToUpperInvariant(),
            ManufactureYear = form.EquipmentManufactureYear,
            EquipmentType = "munck",
            CraneBrand = string.Empty,
            IsActive = true,
            CreatedAt = DateTime.Now,
            UpdatedAt = DateTime.Now
        };
        db.Equipments.Add(equipment);
        form.EquipmentId = equipment.Id;
        equipmentOptions.Add(equipment);
        return equipment;
    }

    private async Task<Rigger?> ResolveRiggerAsync(AppDbContext db)
    {
        if (form.RiggerId is not null)
        {
            return await db.Riggers.SingleOrDefaultAsync(x => x.Id == form.RiggerId);
        }

        if (string.IsNullOrWhiteSpace(form.RiggerDisplayName))
        {
            return null;
        }

        var existing = await db.Riggers.SingleOrDefaultAsync(x => x.DisplayName.ToLower() == form.RiggerDisplayName.Trim().ToLower());
        if (existing is not null)
        {
            form.RiggerId = existing.Id;
            return existing;
        }

        var rigger = new Rigger
        {
            Id = Guid.NewGuid(),
            FullName = string.IsNullOrWhiteSpace(form.RiggerFullName) ? form.RiggerDisplayName.Trim() : form.RiggerFullName.Trim(),
            DisplayName = form.RiggerDisplayName.Trim(),
            RppNumber = string.IsNullOrWhiteSpace(form.RiggerRppNumber) ? "000" : form.RiggerRppNumber.Trim(),
            CreaNumber = string.IsNullOrWhiteSpace(form.RiggerCreaNumber) ? null : form.RiggerCreaNumber.Trim(),
            IsActive = true
        };
        db.Riggers.Add(rigger);
        form.RiggerId = rigger.Id;
        riggerOptions.Add(rigger);
        return rigger;
    }

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        equipmentOptions = await db.Equipments.AsNoTracking().Where(x => x.IsActive).OrderBy(x => x.CraneModel).ToListAsync();
        riggerOptions = await db.Riggers.AsNoTracking().Where(x => x.IsActive).OrderBy(x => x.DisplayName).ToListAsync();
        clientOptions = await db.Clients.AsNoTracking().Where(x => x.IsActive).OrderBy(x => x.Name).ToListAsync();
        if (Draft.IsInitialized
            && ((PlanId is not null && Draft.PlanId == PlanId)
                || (PlanId is null && !Draft.IsPersisted)))
        {
            plan = Draft.Plan;
            isDraftPlan = !Draft.IsPersisted;
            isNewClientSelected = Draft.Plan?.ClientId is null && !string.IsNullOrWhiteSpace(form.ClientName);
            isNewRiggerSelected = Draft.Plan?.RiggerId is null && !string.IsNullOrWhiteSpace(form.RiggerDisplayName);
            isNewEquipmentSelected = Draft.Plan?.EquipmentId is null && !string.IsNullOrWhiteSpace(form.EquipmentModel);
            form.IsNewRigger = isNewRiggerSelected;
            form.IsNewEquipment = isNewEquipmentSelected;
            if (Draft.IsPersisted && Draft.Plan is not null && string.IsNullOrWhiteSpace(form.OperationName))
            {
                LoadFormFromPlan(Draft.Plan);
            }
            return;
        }

        if (PlanId is null)
        {
            if (Draft.IsPersisted) Draft.Reset();
            Draft.PlanId ??= Guid.NewGuid();
            Draft.Plan ??= new RiggingPlan { Id = Draft.PlanId.Value };
            Draft.IsPersisted = false;
            Draft.IsInitialized = true;
            plan = Draft.Plan;
            return;
        }

        plan = await db.RiggingPlans.AsNoTracking().SingleOrDefaultAsync(x => x.Id == PlanId);
        if (plan is null)
        {
            errorMessage = "Plano não encontrado.";
            return;
        }

        isReadOnly = plan.Status == "finalized";
        if (isReadOnly)
        {
            equipmentOptions = await db.Equipments.AsNoTracking().OrderBy(x => x.CraneModel).ToListAsync();
            riggerOptions = await db.Riggers.AsNoTracking().OrderBy(x => x.DisplayName).ToListAsync();
            clientOptions = await db.Clients.AsNoTracking().OrderBy(x => x.Name).ToListAsync();
        }
        else if (plan.ClientId is not null && clientOptions.All(x => x.Id != plan.ClientId))
        {
            var linkedClient = await db.Clients.AsNoTracking().SingleOrDefaultAsync(x => x.Id == plan.ClientId);
            if (linkedClient is not null) clientOptions.Add(linkedClient);
        }
        if (plan.RiggerId is not null && riggerOptions.All(x => x.Id != plan.RiggerId))
        {
            var linkedRigger = await db.Riggers.AsNoTracking().SingleOrDefaultAsync(x => x.Id == plan.RiggerId);
            if (linkedRigger is not null) riggerOptions.Add(linkedRigger);
        }
        if (plan.EquipmentId is not null && equipmentOptions.All(x => x.Id != plan.EquipmentId))
        {
            var linkedEquipment = await db.Equipments.AsNoTracking().SingleOrDefaultAsync(x => x.Id == plan.EquipmentId);
            if (linkedEquipment is not null) equipmentOptions.Add(linkedEquipment);
        }

        LoadFormFromPlan(plan);
        Draft.Plan = plan;
        Draft.PlanId = plan.Id;
        Draft.IsPersisted = true;
        Draft.IsInitialized = true;

        var dbAccessories = await db.PlanAccessories.Where(x => x.PlanId == PlanId).OrderBy(x => x.SortOrder).ToListAsync();
        Draft.Accessories.Clear();
        Draft.Accessories.AddRange(dbAccessories);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && SaveRequested && !isReadOnly)
        {
            await (inputForm?.SubmitAsync() ?? Task.CompletedTask);
        }
    }

    private async Task SaveAsync()
    {
        if (isReadOnly) return;
        isSaving = true;
        errorMessage = null;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            await using var transaction = await db.Database.BeginTransactionAsync();

            var client = await ResolveClientAsync(db);
            var equipment = await ResolveEquipmentAsync(db);
            var rigger = await ResolveRiggerAsync(db);

            if (PlanId is not null && !isDraftPlan)
            {
                var existingPlan = await db.RiggingPlans.SingleOrDefaultAsync(x => x.Id == PlanId);
                if (existingPlan is null)
                {
                    errorMessage = "Plano não encontrado.";
                    return;
                }

                existingPlan.PlanDate = form.PlanDate;
                existingPlan.Location = form.Location.Trim();
                existingPlan.OperationName = form.OperationName.Trim();
                existingPlan.ClientId = client?.Id;
                existingPlan.ClientName = client?.Name ?? form.ClientName?.Trim();
                existingPlan.ClientCnpj = client?.Cnpj ?? FormatCnpj(form.ClientCnpj);
                existingPlan.LoadDescription = form.LoadDescription.Trim();
                existingPlan.LengthM = form.LengthM;
                existingPlan.WidthM = form.WidthM;
                existingPlan.HeightM = form.HeightM;
                existingPlan.WeightKg = form.WeightKg;
                existingPlan.Observations = string.IsNullOrWhiteSpace(form.Observations) ? null : form.Observations.Trim();
                existingPlan.EquipmentId = equipment?.Id;
                existingPlan.RiggerId = rigger?.Id;
                CopyCapacityFields(Draft.Plan, existingPlan);
                ApplyReferences(existingPlan, equipmentOptions, riggerOptions);
                existingPlan.UpdatedAt = DateTime.Now;
                await db.SaveChangesAsync();
                await SaveAccessoriesAsync(db, existingPlan.Id);
                await transaction.CommitAsync();
                Draft.Reset();
                Draft.SuppressLeaveConfirmation = true;
                Navigation.NavigateTo("/");
                return;
            }

            var yearMonth = form.PlanDate.ToString("yyMM");
            var counter = await db.PlanNumberCounters.SingleOrDefaultAsync(x => x.YearMonth == yearMonth);
            if (counter is null)
            {
                counter = new PlanNumberCounter { YearMonth = yearMonth, LastSequence = 0 };
                db.PlanNumberCounters.Add(counter);
            }
            counter.LastSequence++;

            var newPlan = new RiggingPlan
            {
                Id = Guid.NewGuid(),
                PlanNumber = $"{yearMonth}{counter.LastSequence:000}",
                PlanDate = form.PlanDate,
                Location = form.Location.Trim(),
                OperationName = form.OperationName.Trim(),
                Client = client,
                ClientName = client?.Name ?? form.ClientName?.Trim(),
                ClientCnpj = client?.Cnpj ?? form.ClientCnpj?.Trim(),
                LoadDescription = form.LoadDescription.Trim(),
                LengthM = form.LengthM,
                WidthM = form.WidthM,
                HeightM = form.HeightM,
                WeightKg = form.WeightKg,
                EquipmentId = equipment?.Id,
                Rigger = rigger,
                RiggerId = rigger?.Id,
                Observations = string.IsNullOrWhiteSpace(form.Observations) ? null : form.Observations.Trim(),
                CreatedAt = DateTime.Now,
                UpdatedAt = DateTime.Now
            };
            CopyCapacityFields(Draft.Plan, newPlan);
            ApplyReferences(newPlan, equipmentOptions, riggerOptions);
            db.RiggingPlans.Add(newPlan);

            await db.SaveChangesAsync();
            await SaveAccessoriesAsync(db, newPlan.Id);
            await transaction.CommitAsync();
            Draft.Reset();
            Draft.SuppressLeaveConfirmation = true;
            Navigation.NavigateTo("/");
        }
        catch (Exception exception)
        {
            errorMessage = $"Não foi possível salvar o plano: {exception.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task<Client?> ResolveClientAsync(AppDbContext db)
    {
        if (form.ClientId is not null)
        {
            return await db.Clients.SingleOrDefaultAsync(x => x.Id == form.ClientId);
        }

        if (string.IsNullOrWhiteSpace(form.ClientName))
        {
            return null;
        }

        var cnpj = FormatCnpj(form.ClientCnpj);
        if (cnpj is null || NormalizeCnpj(cnpj)?.Length != 14)
        {
            throw new InvalidOperationException("Informe um CNPJ válido no formato 00.000.000/0000-00 ou 00.000.000/E08G-12.");
        }

        if ((await db.Clients.AsNoTracking().Select(x => x.Cnpj).ToListAsync()).Any(value => NormalizeCnpj(value) == NormalizeCnpj(cnpj)))
        {
            throw new InvalidOperationException("Já existe um cliente cadastrado com este CNPJ. Selecione-o na lista.");
        }

        var client = new Client
        {
            Id = Guid.NewGuid(),
            Name = form.ClientName.Trim(),
            Cnpj = cnpj,
            CreatedAt = DateTime.Now,
            UpdatedAt = DateTime.Now
        };
        db.Clients.Add(client);
        return client;
    }

    private void OnClientNameInput(ChangeEventArgs args)
    {
        form.ClientName = args.Value?.ToString()?.Trim();
        form.ClientId = null;
        form.ClientCnpj = string.Empty;
    }

    private void SelectClient(Client client)
    {
        form.ClientId = client.Id;
        form.ClientName = client.Name;
        form.ClientCnpj = FormatCnpj(client.Cnpj) ?? string.Empty;
    }

    private void CreateClientFromInput()
    {
        if (string.IsNullOrWhiteSpace(form.ClientName)) return;
        form.ClientId = null;
        isNewClientSelected = true;
    }

    private void RemoveSelectedClient()
    {
        form.ClientId = null;
        form.ClientName = string.Empty;
        form.ClientCnpj = string.Empty;
        isNewClientSelected = false;
    }

    private void OnClientCnpjInput(ChangeEventArgs args) => form.ClientCnpj = FormatCnpj(args.Value?.ToString()) ??
string.Empty;

    private void OnEquipmentModelInput(ChangeEventArgs args)
    {
        form.EquipmentModel = args.Value?.ToString()?.Trim() ?? string.Empty;
        form.EquipmentId = null;
        form.EquipmentTruckModel = string.Empty;
        form.EquipmentChassisNumber = string.Empty;
        form.EquipmentLicensePlate = string.Empty;
        form.EquipmentManufactureYear = null;
        isNewEquipmentSelected = false;
        form.IsNewEquipment = false;
    }

    private void SelectEquipment(Equipment equipment)
    {
        form.EquipmentId = equipment.Id;
        form.EquipmentModel = equipment.CraneModel;
        form.EquipmentTruckModel = equipment.TruckModel;
        form.EquipmentChassisNumber = equipment.ChassisNumber;
        form.EquipmentLicensePlate = equipment.LicensePlate;
        form.EquipmentManufactureYear = equipment.ManufactureYear;
        isNewEquipmentSelected = false;
        form.IsNewEquipment = false;
    }

    private void CreateEquipmentFromInput()
    {
        if (string.IsNullOrWhiteSpace(form.EquipmentModel)) return;
        form.EquipmentId = null;
        isNewEquipmentSelected = true;
        form.IsNewEquipment = true;
    }

    private void RemoveSelectedEquipment()
    {
        form.EquipmentId = null;
        form.EquipmentModel = string.Empty;
        form.EquipmentTruckModel = string.Empty;
        form.EquipmentChassisNumber = string.Empty;
        form.EquipmentLicensePlate = string.Empty;
        form.EquipmentManufactureYear = null;
        isNewEquipmentSelected = false;
        form.IsNewEquipment = false;
    }

    private void OnRiggerNameInput(ChangeEventArgs args)
    {
        form.RiggerDisplayName = args.Value?.ToString()?.Trim() ?? string.Empty;
        form.RiggerId = null;
        form.RiggerFullName = string.Empty;
        form.RiggerRppNumber = string.Empty;
        form.RiggerCreaNumber = string.Empty;
        isNewRiggerSelected = false;
        form.IsNewRigger = false;
    }

    private void SelectRigger(Rigger rigger)
    {
        form.RiggerId = rigger.Id;
        form.RiggerDisplayName = rigger.DisplayName;
        form.RiggerFullName = rigger.FullName;
        form.RiggerRppNumber = rigger.RppNumber;
        form.RiggerCreaNumber = rigger.CreaNumber ?? string.Empty;
        isNewRiggerSelected = false;
        form.IsNewRigger = false;
    }

    private void CreateRiggerFromInput()
    {
        if (string.IsNullOrWhiteSpace(form.RiggerDisplayName)) return;
        form.RiggerId = null;
        isNewRiggerSelected = true;
        form.IsNewRigger = true;
    }

    private void RemoveSelectedRigger()
    {
        form.RiggerId = null;
        form.RiggerDisplayName = string.Empty;
        form.RiggerFullName = string.Empty;
        form.RiggerRppNumber = string.Empty;
        form.RiggerCreaNumber = string.Empty;
        isNewRiggerSelected = false;
        form.IsNewRigger = false;
    }

    private static string? FormatCnpj(string? value)
    {
        var digits = NormalizeCnpj(value);
        return digits?.Length == 14
            ? $"{digits[..2]}.{digits[2..5]}.{digits[5..8]}/{digits[8..12]}-{digits[12..]}"
            : digits;
    }

    private static string? NormalizeCnpj(string? value)
    {
        var normalized = new string((value ?? string.Empty).ToUpperInvariant().Where(char.IsLetterOrDigit).ToArray());
        var prefix = new string(normalized.Take(12).Where(char.IsLetterOrDigit).ToArray());
        var suffix = new string(normalized.Skip(12).Where(char.IsDigit).Take(2).ToArray());
        var digits = prefix + suffix;
        return digits.Length == 0 ? null : digits;
    }

    private static void ApplyReferences(RiggingPlan plan, IReadOnlyCollection<Equipment> equipmentOptions,
IReadOnlyCollection<Rigger> riggerOptions)
    {
        var equipment = plan.EquipmentId is null ? null : equipmentOptions.FirstOrDefault(x => x.Id == plan.EquipmentId);
        if (equipment is not null)
        {
            plan.EquipmentId = equipment.Id;
            plan.TruckModel = equipment.TruckModel;
            plan.LicensePlate = equipment.LicensePlate;
            plan.ChassisNumber = equipment.ChassisNumber;
            plan.ManufactureYear = equipment.ManufactureYear;
            plan.CraneBrand = equipment.CraneBrand;
            plan.CraneModel = equipment.CraneModel;
        }

        var rigger = plan.RiggerId is null ? null : riggerOptions.FirstOrDefault(x => x.Id == plan.RiggerId);
        if (rigger is not null)
        {
            plan.RiggerId = rigger.Id;
            plan.RiggerName = rigger.DisplayName;
            plan.RiggerRpp = rigger.RppNumber;
            plan.RiggerCrea = rigger.CreaNumber;
        }
    }

    private async Task SaveAccessoriesAsync(AppDbContext db, Guid planId)
    {
        var storedItems = await db.PlanAccessories.Where(x => x.PlanId == planId).ToListAsync();
        if (storedItems.Count > 0) db.PlanAccessories.RemoveRange(storedItems);
        foreach (var item in Draft.Accessories)
        {
            item.PlanId = planId;
            item.Plan = null!;
            db.PlanAccessories.Add(item);
        }
        if (storedItems.Count > 0 || Draft.Accessories.Count > 0) await db.SaveChangesAsync();
    }

    private static void CopyCapacityFields(RiggingPlan? source, RiggingPlan target)
    {
        if (source is null) return;
        target.CraneNominalCapacity = source.CraneNominalCapacity;
        target.BoomLengthM = source.BoomLengthM;
        target.ExtraLoadKg = source.ExtraLoadKg;
        target.OperatingRadiusM = source.OperatingRadiusM;
        target.LoadCapacityT = source.LoadCapacityT;
        target.QuadrantStart = source.QuadrantStart;
        target.QuadrantEnd = source.QuadrantEnd;
        target.ArtNumber = source.ArtNumber;
        target.ArtFileId = source.ArtFileId;
        target.FlatStrapUtilizationPct = source.FlatStrapUtilizationPct;
        target.TubularStrapUtilizationPct = source.TubularStrapUtilizationPct;
        target.WireRopeSlingUtilizationPct = source.WireRopeSlingUtilizationPct;
        target.ShackleUtilizationPct = source.ShackleUtilizationPct;
        target.FootingForceKgf = source.FootingForceKgf;
        target.MinGroundResistanceKgfCm2 = source.MinGroundResistanceKgfCm2;
        target.MaxWindSpeedMs = source.MaxWindSpeedMs;
    }

    private void LoadFormFromPlan(RiggingPlan plan)
    {
        form.OperationName = plan.OperationName;
        form.Location = plan.Location;
        form.PlanDate = plan.PlanDate;
        form.ClientId = plan.ClientId;
        form.ClientName = plan.ClientName;
        form.ClientCnpj = FormatCnpj(plan.ClientCnpj) ?? string.Empty;
        isNewClientSelected = plan.ClientId is null && !string.IsNullOrWhiteSpace(plan.ClientName);
        form.LoadDescription = plan.LoadDescription;
        form.WeightKg = plan.WeightKg;
        form.LengthM = plan.LengthM;
        form.WidthM = plan.WidthM;
        form.HeightM = plan.HeightM;
        form.Observations = plan.Observations;
        form.EquipmentId = plan.EquipmentId;
        var linkedEquipment = equipmentOptions.FirstOrDefault(x => x.Id == plan.EquipmentId);
        form.EquipmentModel = linkedEquipment?.CraneModel ?? plan.CraneModel ?? string.Empty;
        form.EquipmentTruckModel = linkedEquipment?.TruckModel ?? plan.TruckModel ?? string.Empty;
        form.EquipmentChassisNumber = linkedEquipment?.ChassisNumber ?? plan.ChassisNumber ?? string.Empty;
        form.EquipmentLicensePlate = linkedEquipment?.LicensePlate ?? plan.LicensePlate ?? string.Empty;
        form.EquipmentManufactureYear = linkedEquipment?.ManufactureYear ?? plan.ManufactureYear;
        isNewEquipmentSelected = plan.EquipmentId is null && !string.IsNullOrWhiteSpace(form.EquipmentModel);
        form.IsNewEquipment = isNewEquipmentSelected;
        form.RiggerId = plan.RiggerId;
        var linkedRigger = riggerOptions.FirstOrDefault(x => x.Id == plan.RiggerId);
        form.RiggerDisplayName = linkedRigger?.DisplayName ?? plan.RiggerName ?? string.Empty;
        form.RiggerFullName = linkedRigger?.FullName ?? plan.RiggerName ?? string.Empty;
        form.RiggerRppNumber = linkedRigger?.RppNumber ?? plan.RiggerRpp ?? string.Empty;
        form.RiggerCreaNumber = linkedRigger?.CreaNumber ?? plan.RiggerCrea ?? string.Empty;
        isNewRiggerSelected = plan.RiggerId is null && !string.IsNullOrWhiteSpace(form.RiggerDisplayName);
        form.IsNewRigger = isNewRiggerSelected;
    }

}
