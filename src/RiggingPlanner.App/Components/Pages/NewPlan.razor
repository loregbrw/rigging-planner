@page "/new-plan"
@page "/new-plan/{PlanId:guid}"
@using Microsoft.AspNetCore.Components
@inject IDbContextFactory<AppDbContext> DbFactory
@inject NavigationManager Navigation

<RpPlanStepLayout Title="@PageTitle"
                  Subtitle="Dados de entrada - Preencha os dados sem perder informações entre as etapas"
                  PlanId="@PlanId"
                  WorkflowPlanId="@WorkflowPlanId"
                  IsNewEntry="@(PlanId is null)"
                  IsNew="@(PlanId is null || isDraftPlan)"
                  CurrentStep="@PlanStepCatalog.Entry"
                  IsReadOnly="@isReadOnly"
                  IsSaving="@isSaving"
                  Save="SaveFormAsync"
                  Discard="AskDiscard">
    <RpPlanEntryForm @ref="inputForm" State="state" IsReadOnly="@isReadOnly" ErrorMessage="@errorMessage"
                     ErrorMessageChanged="@(e => errorMessage = e)" OnValidSubmit="SaveAsync" />
</RpPlanStepLayout>

@code {
    [Parameter] public Guid? PlanId { get; set; }
    [SupplyParameterFromQuery(Name = "save")] public bool SaveRequested { get; set; }
    [Inject] private PlanDraftState Draft { get; set; } = null!;

    private PlanEntryState state = null!;
    private RpPlanEntryForm? inputForm;
    private bool isSaving;
    private bool isReadOnly;
    private bool isDraftPlan;
    private RiggingPlan? plan;
    private string PageTitle => Draft.GetPageTitle(plan);
    private string? errorMessage;
    private Guid WorkflowPlanId => PlanId ?? Draft.PlanId ?? Guid.Empty;

    protected override async Task OnInitializedAsync()
    {
        state = new PlanEntryState(Draft);
        await using var db = await DbFactory.CreateDbContextAsync();
        await state.LoadActiveLookupsAsync(db);
        var form = Draft.Form;

        if (Draft.IsInitialized
            && ((PlanId is not null && Draft.PlanId == PlanId)
                || (PlanId is null && !Draft.IsPersisted)))
        {
            plan = Draft.Plan;
            isDraftPlan = !Draft.IsPersisted;
            state.RestoreDraftFlags(plan);
            if (Draft.IsPersisted && Draft.Plan is not null && string.IsNullOrWhiteSpace(form.OperationName))
            {
                state.LoadFromPlan(Draft.Plan);
            }
            return;
        }

        if (PlanId is null)
        {
            if (Draft.IsPersisted) Draft.Reset();
            Draft.PlanId ??= Guid.NewGuid();
            Draft.Plan ??= new RiggingPlan { Id = Draft.PlanId.Value };
            Draft.IsPersisted = false;
            Draft.IsInitialized = true;
            plan = Draft.Plan;
            return;
        }

        plan = await PlanWorkflowLoader.LoadAsync(db, Draft, PlanId.Value, includeAccessories: true);
        if (plan is null)
        {
            errorMessage = "Plano não encontrado.";
            return;
        }

        isReadOnly = plan.Status == "finalized";
        await state.ConfigureForPlanAsync(db, plan, isReadOnly);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && SaveRequested && !isReadOnly)
        {
            await (inputForm?.SubmitAsync() ?? Task.CompletedTask);
        }
    }

    private Task SaveFormAsync() => inputForm?.SubmitAsync() ?? Task.CompletedTask;

    private async Task SaveAsync()
    {
        if (isReadOnly) return;
        isSaving = true;
        errorMessage = null;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var error = await PlanEntryPersistence.SaveAsync(db, Draft, PlanId, isDraftPlan, state);
            if (error is not null)
            {
                errorMessage = error;
                return;
            }

            Draft.Reset();
            Draft.SuppressLeaveConfirmation = true;
            Navigation.NavigateTo("/");
        }
        catch (Exception exception)
        {
            errorMessage = $"Não foi possível salvar o plano: {exception.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private void AskDiscard() => DiscardChanges();

    private void DiscardChanges()
    {
        Draft.Reset();
        Draft.SuppressLeaveConfirmation = true;
        Navigation.NavigateTo("/");
    }
}
