@page "/new-plan"

<RpPageHeader Title="Novo plano" Subtitle="Preencha os dados sem perder informações entre as etapas" />

<div class="rp-stack">
    <RpStepper Steps="steps" Current="0" />

    <RpCard Title="Dados de entrada">
        <p class="rp-muted">Esta etapa será implementada nos próximos commits.</p>
    </RpCard>
</div>

@code {
    private readonly string[] steps = ["Dados de entrada", "Capacidade", "Anexos", "Preview", "Exportação"];
}
