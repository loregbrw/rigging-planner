@page "/new-plan"
@page "/new-plan/{PlanId:guid}"
@using Microsoft.AspNetCore.Components
@using Microsoft.JSInterop
@inject IDbContextFactory<AppDbContext> DbFactory
@inject NavigationManager Navigation
@inject IJSRuntime JS

<RpPageHeader Title="@((PlanId is null || isDraftPlan) ? "Novo plano" : isReadOnly ? "Plano finalizado" : "Editar plano")"
              Subtitle="Dados de entrada — Preencha os dados sem perder informações entre as etapas">
    <Actions>
        <RpPlanActions IsNew="@(PlanId is null || isDraftPlan)" IsReadOnly="@isReadOnly" IsSaving="@isSaving"
                       Save="SaveFormAsync" Discard="AskDiscard" />
    </Actions>
</RpPageHeader>

<div class="rp-stack">
    <RpStepper Steps="steps" Links="stepLinks" Current="0" />
    <RpPlanNavigation PreviousUrl="@null" NextUrl="@($"new-plan/{WorkflowPlanId}/capacity")" />
    <RpPlanInputForm Model="form" IsReadOnly="isReadOnly" IsSaving="isSaving" ErrorMessage="@errorMessage"
                     EquipmentOptions="equipmentOptions" RiggerOptions="riggerOptions"
                     ClientSuggestions="ClientSuggestions" SelectedClient="SelectedClient"
                     IsNewClientSelected="isNewClientSelected" IsExistingClient="IsExistingClient"
                     HasExactClient="HasExactClient" OnValidSubmit="SaveAsync"
                     OnClientNameInput="OnClientNameInput" OnClientSelect="SelectClient"
                     OnClientCreate="CreateClientFromInput" OnClientRemove="RemoveSelectedClient"
                     OnClientCnpjInput="OnClientCnpjInput" @ref="inputForm" />
</div>

@code {
    private readonly string[] steps = ["Dados de entrada", "Capacidade", "Anexos", "Preview", "Exportação"];
    [Parameter] public Guid? PlanId { get; set; }
    [SupplyParameterFromQuery(Name = "save")]
    public bool SaveRequested { get; set; }
    [Inject] private PlanDraftState Draft { get; set; } = null!;
    private PlanFormModel form => Draft.Form;
    private RpPlanInputForm? inputForm;
    private IReadOnlyList<string> stepLinks =>
        [$"new-plan{(PlanId is null ? string.Empty : $"/{WorkflowPlanId}")}",
         $"new-plan/{WorkflowPlanId}/capacity", $"new-plan/{WorkflowPlanId}/attachments",
         $"new-plan/{WorkflowPlanId}/preview", $"new-plan/{WorkflowPlanId}/export"];
    private List<Equipment> equipmentOptions = [];
    private List<Rigger> riggerOptions = [];
    private List<Client> clientOptions = [];
    private bool isSaving;
    private bool isReadOnly;
    private bool isDraftPlan;
    private string? errorMessage;
    private Client? SelectedClient => clientOptions.FirstOrDefault(x => x.Id == form.ClientId);
    private bool HasExactClient => clientOptions.Any(x => string.Equals(x.Name, form.ClientName?.Trim(),
StringComparison.CurrentCultureIgnoreCase));
    private List<Client> ClientSuggestions => string.IsNullOrWhiteSpace(form.ClientName)
        ? []
        : clientOptions.Where(x => x.Name.Contains(form.ClientName.Trim(),
StringComparison.CurrentCultureIgnoreCase)).Take(8).ToList();
    private bool isNewClientSelected;

    private Guid WorkflowPlanId => PlanId ?? Draft.PlanId ?? Guid.Empty;
    private Task SaveFormAsync() => inputForm?.SubmitAsync() ?? Task.CompletedTask;
    private void AskDiscard() => DiscardChanges();
    private void DiscardChanges()
    {
        Draft.Reset();
        Navigation.NavigateTo("/");
    }

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        equipmentOptions = await db.Equipments.AsNoTracking().Where(x => x.IsActive).OrderBy(x => x.CraneModel).ToListAsync();
        riggerOptions = await db.Riggers.AsNoTracking().Where(x => x.IsActive).OrderBy(x => x.DisplayName).ToListAsync();
        clientOptions = await db.Clients.AsNoTracking().Where(x => x.IsActive).OrderBy(x => x.Name).ToListAsync();
        if (Draft.IsInitialized
            && ((PlanId is not null && Draft.PlanId == PlanId)
                || (PlanId is null && !Draft.IsPersisted)))
        {
            isDraftPlan = !Draft.IsPersisted;
            isNewClientSelected = Draft.Plan?.ClientId is null && !string.IsNullOrWhiteSpace(form.ClientName);
            return;
        }

        if (PlanId is null)
        {
            if (Draft.IsPersisted) Draft.Reset();
            Draft.PlanId ??= Guid.NewGuid();
            Draft.Plan ??= new RiggingPlan { Id = Draft.PlanId.Value };
            Draft.IsPersisted = false;
            Draft.IsInitialized = true;
            return;
        }

        var plan = await db.RiggingPlans.AsNoTracking().SingleOrDefaultAsync(x => x.Id == PlanId);
        if (plan is null)
        {
            errorMessage = "Plano não encontrado.";
            return;
        }

        isReadOnly = plan.Status == "finalized";
        if (isReadOnly)
        {
            equipmentOptions = await db.Equipments.AsNoTracking().OrderBy(x => x.CraneModel).ToListAsync();
            riggerOptions = await db.Riggers.AsNoTracking().OrderBy(x => x.DisplayName).ToListAsync();
            clientOptions = await db.Clients.AsNoTracking().OrderBy(x => x.Name).ToListAsync();
        }
        else if (plan.ClientId is not null && clientOptions.All(x => x.Id != plan.ClientId))
        {
            var linkedClient = await db.Clients.AsNoTracking().SingleOrDefaultAsync(x => x.Id == plan.ClientId);
            if (linkedClient is not null) clientOptions.Add(linkedClient);
        }

        form.OperationName = plan.OperationName;
        form.Location = plan.Location;
        form.PlanDate = plan.PlanDate;
        form.ClientId = plan.ClientId;
        form.ClientName = plan.ClientName;
        form.ClientCnpj = FormatCnpj(plan.ClientCnpj) ?? string.Empty;
        isNewClientSelected = plan.ClientId is null && !string.IsNullOrWhiteSpace(plan.ClientName);
        form.LoadDescription = plan.LoadDescription;
        form.WeightKg = plan.WeightKg;
        form.LengthM = plan.LengthM;
        form.WidthM = plan.WidthM;
        form.Observations = plan.Observations;
        form.EquipmentId = plan.EquipmentId;
        form.RiggerId = plan.RiggerId;
        Draft.Plan = plan;
        Draft.PlanId = plan.Id;
        Draft.IsPersisted = true;
        Draft.IsInitialized = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && SaveRequested && !isReadOnly)
        {
            await (inputForm?.SubmitAsync() ?? Task.CompletedTask);
        }
    }

    private async Task SaveAsync()
    {
        if (isReadOnly) return;
        isSaving = true;
        errorMessage = null;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            await using var transaction = await db.Database.BeginTransactionAsync();

            if (PlanId is not null && !isDraftPlan)
            {
                var existingPlan = await db.RiggingPlans.SingleOrDefaultAsync(x => x.Id == PlanId);
                if (existingPlan is null)
                {
                    errorMessage = "Plano não encontrado.";
                    return;
                }

                existingPlan.PlanDate = form.PlanDate;
                existingPlan.Location = form.Location.Trim();
                existingPlan.OperationName = form.OperationName.Trim();
                var existingClient = await ResolveClientAsync(db);
                existingPlan.ClientId = existingClient?.Id;
                existingPlan.ClientName = existingClient?.Name ?? form.ClientName?.Trim();
                existingPlan.ClientCnpj = existingClient?.Cnpj ?? FormatCnpj(form.ClientCnpj);
                existingPlan.LoadDescription = form.LoadDescription.Trim();
                existingPlan.LengthM = form.LengthM;
                existingPlan.WidthM = form.WidthM;
                existingPlan.WeightKg = form.WeightKg;
                existingPlan.Observations = string.IsNullOrWhiteSpace(form.Observations) ? null : form.Observations.Trim();
                existingPlan.EquipmentId = form.EquipmentId;
                existingPlan.RiggerId = form.RiggerId;
                CopyCapacityFields(Draft.Plan, existingPlan);
                ApplyReferences(existingPlan, equipmentOptions, riggerOptions);
                existingPlan.UpdatedAt = DateTime.Now;
                await db.SaveChangesAsync();
                await SaveAccessoriesAsync(db, existingPlan.Id);
                await transaction.CommitAsync();
                Navigation.NavigateTo("/");
                return;
            }

            var client = await ResolveClientAsync(db);

            var yearMonth = form.PlanDate.ToString("yyMM");
            var counter = await db.PlanNumberCounters.SingleOrDefaultAsync(x => x.YearMonth == yearMonth);
            if (counter is null)
            {
                counter = new PlanNumberCounter { YearMonth = yearMonth, LastSequence = 0 };
                db.PlanNumberCounters.Add(counter);
            }
            counter.LastSequence++;

            var newPlan = new RiggingPlan
            {
                Id = Guid.NewGuid(),
                PlanNumber = $"{yearMonth}{counter.LastSequence:000}",
                PlanDate = form.PlanDate,
                Location = form.Location.Trim(),
                OperationName = form.OperationName.Trim(),
                Client = client,
                ClientName = client?.Name ?? form.ClientName?.Trim(),
                ClientCnpj = client?.Cnpj ?? form.ClientCnpj?.Trim(),
                LoadDescription = form.LoadDescription.Trim(),
                LengthM = form.LengthM,
                WidthM = form.WidthM,
                WeightKg = form.WeightKg,
                EquipmentId = form.EquipmentId,
                RiggerId = form.RiggerId,
                Observations = string.IsNullOrWhiteSpace(form.Observations) ? null : form.Observations.Trim(),
                CreatedAt = DateTime.Now,
                UpdatedAt = DateTime.Now
            };
            CopyCapacityFields(Draft.Plan, newPlan);
            ApplyReferences(newPlan, equipmentOptions, riggerOptions);
            db.RiggingPlans.Add(newPlan);

            await db.SaveChangesAsync();
            await SaveAccessoriesAsync(db, newPlan.Id);
            await transaction.CommitAsync();
            Navigation.NavigateTo("/");
        }

        catch (Exception exception)
        {
            errorMessage = $"Não foi possível salvar o plano: {exception.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task<Client?> ResolveClientAsync(AppDbContext db)
    {
        if (form.ClientId is not null)
        {
            return await db.Clients.SingleOrDefaultAsync(x => x.Id == form.ClientId);
        }

        if (string.IsNullOrWhiteSpace(form.ClientName))
        {
            return null;
        }

        var cnpj = FormatCnpj(form.ClientCnpj);
        if (cnpj is null || NormalizeCnpj(cnpj)?.Length != 14)
        {
            throw new InvalidOperationException("Informe um CNPJ válido no formato 00.000.000/0000-00 ou 00.000.000/E08G-12.");
        }

        if ((await db.Clients.AsNoTracking().Select(x => x.Cnpj).ToListAsync()).Any(value => NormalizeCnpj(value) ==
NormalizeCnpj(cnpj)))
        {
            throw new InvalidOperationException("Já existe um cliente cadastrado com este CNPJ. Selecione-o na lista.");
        }

        var client = new Client
        {
            Id = Guid.NewGuid(),
            Name = form.ClientName.Trim(),
            Cnpj = cnpj,
            CreatedAt = DateTime.Now,
            UpdatedAt = DateTime.Now
        };
        db.Clients.Add(client);
        return client;
    }

    private bool IsExistingClient => form.ClientId is not null;

    private void OnClientNameInput(ChangeEventArgs args)
    {
        form.ClientName = args.Value?.ToString()?.Trim();
        form.ClientId = null;
        form.ClientCnpj = string.Empty;
    }

    private void SelectClient(Client client)
    {
        form.ClientId = client.Id;
        form.ClientName = client.Name;
        form.ClientCnpj = FormatCnpj(client.Cnpj) ?? string.Empty;
    }

    private void CreateClientFromInput()
    {
        if (string.IsNullOrWhiteSpace(form.ClientName)) return;
        form.ClientId = null;
        isNewClientSelected = true;
    }

    private void RemoveSelectedClient()
    {
        form.ClientId = null;
        form.ClientName = string.Empty;
        form.ClientCnpj = string.Empty;
        isNewClientSelected = false;
    }

    private void OnClientCnpjInput(ChangeEventArgs args) => form.ClientCnpj = FormatCnpj(args.Value?.ToString()) ??
string.Empty;


    private static string? FormatCnpj(string? value)
    {
        var digits = NormalizeCnpj(value);
        return digits?.Length == 14
            ? $"{digits[..2]}.{digits[2..5]}.{digits[5..8]}/{digits[8..12]}-{digits[12..]}"
            : digits;
    }

    private static string? NormalizeCnpj(string? value)
    {
        var normalized = new string((value ?? string.Empty).ToUpperInvariant().Where(char.IsLetterOrDigit).ToArray());
        var prefix = new string(normalized.Take(12).Where(char.IsLetterOrDigit).ToArray());
        var suffix = new string(normalized.Skip(12).Where(char.IsDigit).Take(2).ToArray());
        var digits = prefix + suffix;
        return digits.Length == 0 ? null : digits;
    }

    private static void ApplyReferences(RiggingPlan plan, IReadOnlyCollection<Equipment> equipmentOptions,
IReadOnlyCollection<Rigger> riggerOptions)
    {
        var equipment = plan.EquipmentId is null ? null : equipmentOptions.FirstOrDefault(x => x.Id == plan.EquipmentId);
        if (equipment is not null)
        {
            plan.EquipmentId = equipment.Id;
            plan.TruckModel = equipment.TruckModel;
            plan.LicensePlate = equipment.LicensePlate;
            plan.ChassisNumber = equipment.ChassisNumber;
            plan.ManufactureYear = equipment.ManufactureYear;
            plan.CraneBrand = equipment.CraneBrand;
            plan.CraneModel = equipment.CraneModel;
            plan.CraneNominalCapacity = equipment.NominalCapacity;
        }

        var rigger = plan.RiggerId is null ? null : riggerOptions.FirstOrDefault(x => x.Id == plan.RiggerId);
        if (rigger is not null)
        {
            plan.RiggerId = rigger.Id;
            plan.RiggerName = rigger.DisplayName;
            plan.RiggerRpp = rigger.RppNumber;
            plan.RiggerCrea = rigger.CreaNumber;
        }
    }

    private async Task SaveAccessoriesAsync(AppDbContext db, Guid planId)
    {
        var storedItems = await db.PlanAccessories.Where(x => x.PlanId == planId).ToListAsync();
        if (storedItems.Count > 0) db.PlanAccessories.RemoveRange(storedItems);
        foreach (var item in Draft.Accessories)
        {
            item.PlanId = planId;
            item.Plan = null!;
            db.PlanAccessories.Add(item);
        }
        if (storedItems.Count > 0 || Draft.Accessories.Count > 0) await db.SaveChangesAsync();
    }

    private static void CopyCapacityFields(RiggingPlan? source, RiggingPlan target)
    {
        if (source is null) return;
        target.BoomLengthM = source.BoomLengthM;
        target.OperatingRadiusM = source.OperatingRadiusM;
        target.LoadCapacityT = source.LoadCapacityT;
        target.QuadrantStart = source.QuadrantStart;
        target.QuadrantEnd = source.QuadrantEnd;
        target.FlatStrapUtilizationPct = source.FlatStrapUtilizationPct;
        target.TubularStrapUtilizationPct = source.TubularStrapUtilizationPct;
        target.WireRopeSlingUtilizationPct = source.WireRopeSlingUtilizationPct;
        target.ShackleUtilizationPct = source.ShackleUtilizationPct;
        target.FootingForceKgf = source.FootingForceKgf;
        target.MinGroundResistanceKgfCm2 = source.MinGroundResistanceKgfCm2;
        target.MaxWindSpeedMs = source.MaxWindSpeedMs;
    }

}
