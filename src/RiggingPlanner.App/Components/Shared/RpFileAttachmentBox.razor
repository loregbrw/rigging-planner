@using Microsoft.AspNetCore.Components.Forms

<div class="rp-field">
    @if (!string.IsNullOrWhiteSpace(FileName))
    {
        <div style="display: flex; align-items: center; justify-content: space-between; padding: var(--rp-space-3) var(--rp-space-4); background: var(--rp-surface); border: 1px solid var(--rp-border-subtle); border-radius: var(--rp-radius-md);">
            <div style="display: flex; align-items: center; gap: var(--rp-space-3); overflow: hidden;">
                <svg class="rp-icon" style="color: var(--rp-accent); flex-shrink: 0;"
                     viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                    <polyline points="14 2 14 8 20 8"></polyline>
                </svg>
                <div style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                    <div style="font-weight: 600; font-size: var(--rp-text-sm);">@FileName</div>
                    @if (FileSize.HasValue && FileSize.Value > 0)
                    {
                        <div style="font-size: var(--rp-text-xs); color: var(--rp-text-secondary);">@FormatByteSize(FileSize.Value)</div>
                    }
                </div>
            </div>
            @if (!IsReadOnly)
            {
                <div style="display: flex; gap: var(--rp-space-2); flex-shrink: 0;">
                    <InputFile id="@InputId" class="rp-file-input" OnChange="OnChange" accept="@Accept" />
                    <label class="rp-btn rp-btn--ghost rp-btn--sm" for="@InputId">Trocar</label>
                    @if (OnRemove.HasDelegate)
                    {
                        <button class="rp-btn rp-btn--danger-outline rp-btn--sm" type="button" @onclick="OnRemove">Excluir</button>
                    }
                </div>
            }
        </div>
    }
    else
    {
        @if (!IsReadOnly)
        {
            <div style="display: flex; flex-direction: column; gap: var(--rp-space-2);">
                <InputFile id="@InputId" class="rp-file-input" OnChange="OnChange" accept="@Accept" />
                <label class="rp-btn rp-btn--ghost-outline" for="@InputId"
                       style="display: inline-flex; align-items: center; justify-content: center; gap: var(--rp-space-2); cursor: pointer; width: 100%;">
                    <svg class="rp-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M12 16V4m0 0-4 4m4-4 4 4M5 14v4a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-4" />
                    </svg>
                    @ButtonLabel
                </label>
                @if (!string.IsNullOrWhiteSpace(HelpText))
                {
                    <span class="rp-help">@HelpText</span>
                }
            </div>
        }
        else
        {
            <span class="rp-muted">Nenhum arquivo anexado.</span>
        }
    }
</div>

@code {
    [Parameter] public string InputId { get; set; } = "file-upload";
    [Parameter] public string? FileName { get; set; }
    [Parameter] public long? FileSize { get; set; }
    [Parameter] public string Accept { get; set; } = ".pdf,application/pdf";
    [Parameter] public string ButtonLabel { get; set; } = "Escolher arquivo PDF";
    [Parameter] public string? HelpText { get; set; } = "Somente arquivo PDF (máx. 10MB)";
    [Parameter] public bool IsReadOnly { get; set; }
    [Parameter] public EventCallback<InputFileChangeEventArgs> OnChange { get; set; }
    [Parameter] public EventCallback OnRemove { get; set; }

    private static string FormatByteSize(long bytes)
    {
        string[] suffixes = ["B", "KB", "MB", "GB"];
        int i = 0;
        double d = bytes;
        while (d >= 1024 && i < suffixes.Length - 1)
        {
            d /= 1024;
            i++;
        }
        return $"{d:0.##} {suffixes[i]}";
    }
}
