@using Microsoft.AspNetCore.Components.Forms
@using RiggingPlanner.Application.EquipmentArts
@inject IEquipmentArtService ArtService

@if (IsOpen && Equipment is not null)
{
    <div class="rp-modal-backdrop" @onclick="CloseAsync">
        <div class="rp-modal" @onclick:stopPropagation="true" role="dialog" aria-modal="true" aria-labelledby="art-modal-title">
            <div class="rp-modal__header">
                <div>
                    <h2 id="art-modal-title" class="rp-section-title">Gerenciar Laudos de Segurança - @Equipment.CraneModel (@Equipment.LicensePlate)</h2>
                    <p class="rp-help">Adicione, edite ou remova os laudos técnicos de segurança deste equipamento (informando o número e a ART associada).</p>
                </div>
                <button class="rp-btn rp-btn--ghost rp-btn--sm" type="button" @onclick="CloseAsync" aria-label="Fechar">✕</button>
            </div>

            @if (!string.IsNullOrWhiteSpace(message))
            {
                <div class="rp-alert @(isError ? "rp-alert--danger" : "rp-alert--success")">@message</div>
            }

            @if (items.Count > 0)
            {
                <div class="rp-table-wrap" style="margin-bottom: var(--rp-space-5);">
                    <table class="rp-table">
                        <thead>
                            <tr><th>Número da ART</th><th>Período</th><th>Anexo</th><th>Status</th><th></th></tr>
                        </thead>
                        <tbody>
                            @foreach (var item in items)
                            {
                                <tr class="@(IsCurrent(item) ? string.Empty : "rp-row--inactive")">
                                    <td>@item.ArtNumber</td>
                                    <td>@FormatPeriod(item)</td>
                                    <td>@(item.File?.Name ?? item.ExistingFileName ?? "-")</td>
                                    <td><span class="rp-badge @(IsCurrent(item) ? "rp-badge--success" : "rp-badge--muted")">@(IsCurrent(item) ? "Válida" : "Vencida")</span></td>
                                    <td class="rp-row-actions">
                                        <button class="rp-btn rp-btn--ghost rp-btn--sm" type="button" @onclick="() => BeginEdit(item)">Editar</button>
                                        <button class="rp-btn rp-btn--danger-outline rp-btn--sm" type="button" @onclick="() => AskRemove(item)">Excluir</button>
                                    </td>
                                </tr>
                                @if (pendingRemoval == item)
                                {
                                    <tr class="rp-row--inactive">
                                        <td colspan="5">
                                            <div class="rp-alert rp-alert--danger rp-confirm">
                                                <span>Confirma a exclusão deste laudo?</span>
                                                <button class="rp-btn rp-btn--danger rp-btn--sm" type="button" @onclick="ConfirmRemoveAsync" disabled="@isBusy">Excluir laudo</button>
                                                <button class="rp-btn rp-btn--ghost rp-btn--sm" type="button" @onclick="CancelRemove">Cancelar</button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="rp-alert rp-alert--info" style="margin-bottom: var(--rp-space-5);">Este equipamento ainda não possui laudos técnicos cadastrados. Cadastre pelo menos um laudo abaixo.</div>
            }

            <div class="rp-card" style="padding: var(--rp-space-4); background: var(--rp-surface-muted);">
                <h3 class="rp-section-title" style="font-size: 1rem; margin-bottom: var(--rp-space-3);">
                    @(editingItem is null ? "Adicionar novo laudo técnico" : $"Editando laudo da ART {editingItem.ArtNumber}")
                </h3>
                <div class="rp-form-grid">
                    <div class="rp-field rp-col-4">
                        <label class="rp-label" for="modal-art-number">Número da ART (do laudo) <span class="rp-required-marker" aria-hidden="true">*</span></label>
                        <input id="modal-art-number" class="rp-input" @bind="draft.ArtNumber" placeholder="Ex: 2026/123456" />
                    </div>
                    <div class="rp-field rp-col-4">
                        <label class="rp-label" for="modal-art-from">Data de início <span class="rp-required-marker" aria-hidden="true">*</span></label>
                        <input id="modal-art-from" type="date" class="rp-input" @bind="draft.ValidFrom" />
                    </div>
                    <div class="rp-field rp-col-4">
                        <label class="rp-label" for="modal-art-to">Previsão de término <span class="rp-required-marker" aria-hidden="true">*</span></label>
                        <input id="modal-art-to" type="date" class="rp-input" @bind="draft.ValidTo" />
                    </div>
                    <div class="rp-field rp-col-12">
                        <label class="rp-label">Anexo PDF do laudo técnico de segurança <span class="rp-required-marker" aria-hidden="true">*</span></label>
                        <RpFileAttachmentBox InputId="modal-art-file"
                                             FileName="@(draft.File?.Name ?? draft.ExistingFileName)"
                                             FileSize="@draft.File?.Size"
                                             ButtonLabel="Escolher arquivo PDF do laudo"
                                             HelpText="Somente arquivo PDF"
                                             OnChange="OnFileChange"
                                             OnRemove="@(() => { draft.File = null; draft.ExistingFileName = null; })" />
                    </div>
                </div>

                <div class="rp-form-actions" style="margin-top: var(--rp-space-4);">
                    @if (editingItem is not null)
                    {
                        <button class="rp-btn rp-btn--ghost" type="button" @onclick="CancelEdit">Cancelar edição</button>
                    }
                    <button class="rp-btn rp-btn--primary" type="button" @onclick="SaveDraftAsync" disabled="@isBusy">
                        @(editingItem is null ? "Adicionar laudo" : "Salvar alterações do laudo")
                    </button>
                </div>
            </div>

            <div class="rp-form-actions" style="margin-top: var(--rp-space-5); justify-content: flex-end;">
                <button class="rp-btn rp-btn--ghost" type="button" @onclick="CloseAsync">Concluir / Fechar</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public Equipment? Equipment { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }

    private List<EquipmentArtDraft> items = [];
    private EquipmentArtDraft draft = new();
    private EquipmentArtDraft? editingItem;
    private EquipmentArtDraft? pendingRemoval;
    private string? message;
    private bool isError;
    private bool isBusy;

    protected override async Task OnParametersSetAsync()
    {
        if (IsOpen && Equipment is not null)
        {
            await LoadItemsAsync();
            CancelEdit();
            message = null;
        }
    }

    private async Task LoadItemsAsync()
    {
        if (Equipment is null) return;
        var reports = await ArtService.ListAsync(Equipment.Id);
        items = reports.Select(x => new EquipmentArtDraft
        {
            Id = x.Id,
            ArtNumber = x.ArtNumber,
            ValidFrom = x.ValidFrom,
            ValidTo = x.ValidTo,
            ExistingFileName = x.FileName
        }).ToList();
    }

    private async Task OnFileChange(InputFileChangeEventArgs args)
    {
        if (!IsPdf(args.File))
        {
            draft.File = null;
            message = "Anexe somente arquivos PDF.";
            isError = true;
            return;
        }

        draft.File = args.File;
        message = null;
        isError = false;
        await Task.CompletedTask;
    }

    private async Task SaveDraftAsync()
    {
        message = ValidateDraft();
        if (message is not null)
        {
            isError = true;
            return;
        }

        isBusy = true;
        message = null;
        isError = false;

        try
        {
            var creating = editingItem is null || editingItem.Id is null;
            var error = await ArtService.SaveAsync(new EquipmentArtSaveRequest
            {
                Id = editingItem?.Id,
                EquipmentId = Equipment!.Id,
                ArtNumber = draft.ArtNumber,
                ValidFrom = draft.ValidFrom,
                ValidTo = draft.ValidTo,
                FileName = draft.File?.Name,
                ContentType = draft.File?.ContentType,
                PdfContent = draft.File is null ? null : await ReadFileBytesAsync(draft.File)
            });
            if (error is not null)
            {
                message = error;
                isError = true;
                return;
            }

            message = creating ? EquipmentArtMessages.Added : EquipmentArtMessages.Updated;
            await LoadItemsAsync();
            CancelEdit();
            await OnChanged.InvokeAsync();
        }
        catch (Exception ex)
        {
            message = $"Erro ao salvar ART: {ex.Message}";
            isError = true;
        }
        finally
        {
            isBusy = false;
        }
    }

    private string? ValidateDraft()
    {
        if (string.IsNullOrWhiteSpace(draft.ArtNumber)) return "Informe o número da ART.";
        if (draft.ValidFrom is null) return "Informe a data de início da ART.";
        if (draft.ValidTo is null) return "Informe a previsão de término da ART.";
        if (draft.ValidTo < draft.ValidFrom)
            return "A previsão de término deve ser posterior à data de início.";
        if (draft.File is null && string.IsNullOrWhiteSpace(draft.ExistingFileName)) return "Anexe o arquivo PDF da ART.";
        if (draft.File is not null && !IsPdf(draft.File)) return "Anexe somente arquivos PDF.";
        return null;
    }

    private void BeginEdit(EquipmentArtDraft item)
    {
        draft = new()
        {
            Id = item.Id,
            ArtNumber = item.ArtNumber,
            ValidFrom = item.ValidFrom,
            ValidTo = item.ValidTo,
            ExistingFileName = item.ExistingFileName
        };
        editingItem = item;
        message = null;
        isError = false;
        pendingRemoval = null;
    }

    private void CancelEdit()
    {
        draft = new();
        editingItem = null;
        message = null;
        isError = false;
    }

    private void AskRemove(EquipmentArtDraft item)
    {
        pendingRemoval = item;
        message = null;
    }

    private void CancelRemove()
    {
        pendingRemoval = null;
    }

    private async Task ConfirmRemoveAsync()
    {
        if (pendingRemoval is null || pendingRemoval.Id is null) return;
        isBusy = true;
        message = null;
        isError = false;

        try
        {
            var error = await ArtService.DeleteAsync(pendingRemoval.Id.Value);
            if (error is not null)
            {
                message = error;
                isError = true;
                pendingRemoval = null;
                isBusy = false;
                return;
            }

            if (editingItem == pendingRemoval) CancelEdit();
            pendingRemoval = null;
            message = EquipmentArtMessages.Deleted;
            await LoadItemsAsync();
            await OnChanged.InvokeAsync();
        }
        catch (Exception ex)
        {
            message = $"Erro ao excluir ART: {ex.Message}";
            isError = true;
        }
        finally
        {
            isBusy = false;
        }
    }

    private Task CloseAsync() => OnClose.InvokeAsync();

    private static bool IsCurrent(EquipmentArtDraft item) =>
        item.ValidTo is null || item.ValidTo.Value.Date >= DateTime.Today;

    private static string FormatPeriod(EquipmentArtDraft item) =>
        $"{(item.ValidFrom?.ToString("dd/MM/yyyy") ?? "-")} - {(item.ValidTo?.ToString("dd/MM/yyyy") ?? "-")}";

    private static bool IsPdf(IBrowserFile file) =>
        string.Equals(Path.GetExtension(file.Name), ".pdf", StringComparison.OrdinalIgnoreCase);

    private static async Task<byte[]> ReadFileBytesAsync(IBrowserFile browserFile)
    {
        await using var input = browserFile.OpenReadStream(10 * 1024 * 1024);
        using var memory = new MemoryStream();
        await input.CopyToAsync(memory);
        return memory.ToArray();
    }
}
