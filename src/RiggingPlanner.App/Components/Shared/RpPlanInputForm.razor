<RpCard Title="Dados de entrada">
    @if (IsReadOnly)
    {
        <div class="rp-alert rp-alert--info">Este plano foi finalizado e está somente para leitura.</div>
    }
    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <div class="rp-alert rp-alert--danger">@ErrorMessage</div>
    }

    <EditForm EditContext="@editContext" OnValidSubmit="OnValidSubmit">
        <DataAnnotationsValidator />
        <fieldset disabled="@IsReadOnly" class="rp-readonly-fields">
            <div class="rp-form-grid">
                <div class="rp-field rp-col-12">
                    <label class="rp-label" for="operation">Descrição da operação</label>
                    <InputText id="operation" class="rp-input" @bind-Value="Model.OperationName" />
                    <ValidationMessage For="() => Model.OperationName" />
                </div>
                <div class="rp-field rp-col-6">
                    <label class="rp-label" for="location">Local</label>
                    <InputText id="location" class="rp-input" @bind-Value="Model.Location" />
                    <ValidationMessage For="() => Model.Location" />
                </div>
                <div class="rp-field rp-col-6">
                    <label class="rp-label" for="plan-date">Data do plano</label>
                    <InputDate id="plan-date" class="rp-input" @bind-Value="Model.PlanDate" />
                </div>
                <section class="rp-client-section rp-col-12" aria-labelledby="client-section-title">
                    <h3 id="client-section-title" class="rp-section-title">Cliente</h3>
                    <div class="rp-client-fields">
                        <div class="rp-field">
                            <label class="rp-label" for="client-name">Nome / Razão social</label>
                            <RpTagPicker TItem="Client" InputId="client-name"
                                         InputValue="@(Model.ClientName ?? string.Empty)" Suggestions="ClientSuggestions"
                                         SelectedItem="@(SelectedClient ?? (IsNewClientSelected ? new Client { Name = Model.ClientName ?? string.Empty } : null))"
                                         ItemText="@(client => client.Name)"
                                         CanCreate="@(!string.IsNullOrWhiteSpace(Model.ClientName) && !HasExactClient)"
                                         CreateLabel="@($"Criar cliente “{Model.ClientName?.Trim()}”")"
                                         OnInput="OnClientNameInput" OnSelect="OnClientSelect" OnCreate="OnClientCreate"
                                         OnRemove="OnClientRemove" />
                            <span class="rp-help">Selecione um cadastro existente ou crie um cliente novo.</span>
                        </div>
                        <div class="rp-field">
                            <label class="rp-label" for="cnpj">CNPJ</label>
                            <input id="cnpj" class="rp-input @(IsExistingClient ? "rp-input--disabled" : string.Empty)"
                                   inputmode="text" maxlength="18" placeholder="00.000.000/0000-00"
                                   disabled="@IsExistingClient" value="@Model.ClientCnpj" @oninput="OnClientCnpjInput"
                                   title="@(IsExistingClient ? "CNPJ preenchido pelo cadastro e não editável" : "Informe o CNPJ do novo cliente")" />
                            @if (IsExistingClient)
                            {
                                <span class="rp-help rp-help--disabled">CNPJ do cadastro selecionado — não editável.</span>
                            }
                            else
                            {
                                <span class="rp-help">Obrigatório para novo cliente.</span>
                            }
                        </div>
                    </div>
                </section>
                <div class="rp-field rp-col-6">
                    <label class="rp-label" for="load">Descrição da carga</label>
                    <InputText id="load" class="rp-input" @bind-Value="Model.LoadDescription" />
                    <ValidationMessage For="() => Model.LoadDescription" />
                </div>
                <div class="rp-field rp-col-6">
                    <label class="rp-label" for="equipment">Guindaste / equipamento</label>
                    <InputSelect id="equipment" class="rp-select" @bind-Value="Model.EquipmentId">
                        <option value="">Selecione um equipamento</option>
                        @foreach (var equipment in EquipmentOptions)
                        {
                            <option value="@equipment.Id">@equipment.CraneBrand @equipment.CraneModel — @equipment.LicensePlate</option>
                        }
                    </InputSelect>
                    <a class="rp-inline-link" href="equipments">Cadastrar equipamento</a>
                </div>
                <div class="rp-field rp-col-6">
                    <label class="rp-label" for="rigger">Rigger responsável</label>
                    <InputSelect id="rigger" class="rp-select" @bind-Value="Model.RiggerId">
                        <option value="">Selecione um rigger</option>
                        @foreach (var rigger in RiggerOptions)
                        {
                            <option value="@rigger.Id">@rigger.DisplayName — RPP @rigger.RppNumber</option>
                        }
                    </InputSelect>
                    <a class="rp-inline-link" href="riggers">Cadastrar rigger</a>
                </div>
                <div class="rp-field rp-col-4"><label class="rp-label" for="weight">Peso da carga (kg)</label><RpDecimalInput id="weight" class="rp-input rp-input--num" @bind-Value="Model.WeightKg" /></div>
                <div class="rp-field rp-col-4"><label class="rp-label" for="length">Comprimento (m)</label><RpDecimalInput id="length" class="rp-input rp-input--num" @bind-Value="Model.LengthM" /></div>
                <div class="rp-field rp-col-4"><label class="rp-label" for="width">Largura (m)</label><RpDecimalInput id="width" class="rp-input rp-input--num" @bind-Value="Model.WidthM" /></div>
                <div class="rp-field rp-col-12"><label class="rp-label" for="observations">Observações</label><InputTextArea id="observations" class="rp-textarea" @bind-Value="Model.Observations" /></div>
            </div>
        </fieldset>
    </EditForm>
</RpCard>

@code {
    [Parameter, EditorRequired] public PlanFormModel Model { get; set; } = new();
    [Parameter] public bool IsReadOnly { get; set; }
    [Parameter] public bool IsSaving { get; set; }
    [Parameter] public string? ErrorMessage { get; set; }
    [Parameter] public IReadOnlyList<Equipment> EquipmentOptions { get; set; } = [];
    [Parameter] public IReadOnlyList<Rigger> RiggerOptions { get; set; } = [];
    [Parameter] public IReadOnlyList<Client> ClientSuggestions { get; set; } = [];
    [Parameter] public Client? SelectedClient { get; set; }
    [Parameter] public bool IsNewClientSelected { get; set; }
    [Parameter] public bool IsExistingClient { get; set; }
    [Parameter] public bool HasExactClient { get; set; }
    [Parameter] public EventCallback OnValidSubmit { get; set; }
    [Parameter] public EventCallback<ChangeEventArgs> OnClientNameInput { get; set; }
    [Parameter] public EventCallback<Client> OnClientSelect { get; set; }
    [Parameter] public EventCallback OnClientCreate { get; set; }
    [Parameter] public EventCallback OnClientRemove { get; set; }
    [Parameter] public EventCallback<ChangeEventArgs> OnClientCnpjInput { get; set; }

    private EditContext editContext = null!;

    protected override void OnParametersSet()
    {
        editContext ??= new EditContext(Model);
    }

    public async Task SubmitAsync()
    {
        if (!IsReadOnly && editContext.Validate())
        {
            await OnValidSubmit.InvokeAsync();
        }
    }
}
