<RpCard Title="Dados de entrada">
    @if (IsReadOnly)
    {
        <div class="rp-alert rp-alert--info">Este plano foi finalizado e está somente para leitura.</div>
    }
    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <div class="rp-alert rp-alert--danger">@ErrorMessage</div>
    }

    <EditForm EditContext="@editContext" OnValidSubmit="OnValidSubmit">
        <DataAnnotationsValidator />
        <fieldset disabled="@IsReadOnly" class="rp-readonly-fields">
            <div class="rp-form-grid">
                <section class="rp-client-section rp-col-12" aria-labelledby="identification-section-title">
                    <h3 id="identification-section-title" class="rp-section-title">Identificação do plano</h3>
                    <div class="rp-form-grid">
                        <div class="rp-field rp-col-12">
                            <label class="rp-label" for="operation">Descrição da operação <span class="rp-required-marker" aria-hidden="true">*</span></label>
                            <InputText id="operation" class="rp-input" @bind-Value="Model.OperationName" />
                            <ValidationMessage For="() => Model.OperationName" />
                        </div>
                        <div class="rp-field rp-col-6">
                            <label class="rp-label" for="location">Local <span class="rp-required-marker" aria-hidden="true">*</span></label>
                            <InputText id="location" class="rp-input" @bind-Value="Model.Location" />
                            <ValidationMessage For="() => Model.Location" />
                        </div>
                        <div class="rp-field rp-col-6">
                            <label class="rp-label" for="plan-date">Data do plano <span class="rp-required-marker" aria-hidden="true">*</span></label>
                            <InputDate id="plan-date" class="rp-input" @bind-Value="Model.PlanDate" />
                            <ValidationMessage For="() => Model.PlanDate" />
                        </div>
                    </div>
                </section>
                <section class="rp-client-section rp-col-12" aria-labelledby="client-section-title">
                    <h3 id="client-section-title" class="rp-section-title">Cliente <span class="rp-required-marker" aria-hidden="true">*</span></h3>
                    <div class="rp-client-fields">
                        <div class="rp-field">
                            <label class="rp-label" for="client-name">Nome / Razão social</label>
                            <RpTagPicker TItem="Client" InputId="client-name"
                                         InputValue="@(Model.ClientName ?? string.Empty)" Suggestions="ClientSuggestions"
                                         SelectedItem="@(SelectedClient ?? (IsNewClientSelected ? new Client { Name = Model.ClientName ?? string.Empty } : null))"
                                         ItemText="@(client => client.Name)"
                                         CanCreate="@(!string.IsNullOrWhiteSpace(Model.ClientName) && !HasExactClient)"
                                         CreateLabel="@($"Criar cliente “{Model.ClientName?.Trim()}”")"
                                         OnInput="OnClientNameInput" OnSelect="OnClientSelect" OnCreate="OnClientCreate"
                                         OnRemove="OnClientRemove" />
                            <ValidationMessage For="() => Model.ClientName" />
                            <span class="rp-help">Selecione um cadastro existente ou crie um cliente novo.</span>
                        </div>
                        <div class="rp-field">
                            <label class="rp-label" for="cnpj">CNPJ</label>
                            <input id="cnpj" class="rp-input @(IsExistingClient ? "rp-input--disabled" : string.Empty)"
                                   inputmode="text" maxlength="18" placeholder="00.000.000/0000-00"
                                   disabled="@IsExistingClient" value="@Model.ClientCnpj" @oninput="OnClientCnpjInput"
                                   title="@(IsExistingClient ? "CNPJ preenchido pelo cadastro e não editável" : "Informe o CNPJ do novo cliente")" />
                            <ValidationMessage For="() => Model.ClientCnpj" />
                            @if (IsExistingClient)
                            {
                                <span class="rp-help rp-help--disabled">CNPJ do cadastro selecionado — não editável.</span>
                            }
                            else
                            {
                                <span class="rp-help">Obrigatório para novo cliente.</span>
                            }
                        </div>
                    </div>
                </section>
                <section class="rp-client-section rp-col-12" aria-labelledby="load-section-title">
                    <h3 id="load-section-title" class="rp-section-title">Dados da carga</h3>
                    <div class="rp-form-grid">
                        <div class="rp-field rp-col-12">
                            <label class="rp-label" for="load">Descrição da carga <span class="rp-required-marker" aria-hidden="true">*</span></label>
                            <InputText id="load" class="rp-input" @bind-Value="Model.LoadDescription" />
                            <ValidationMessage For="() => Model.LoadDescription" />
                        </div>
                        <div class="rp-field rp-col-3">
                            <label class="rp-label" for="length">Comprimento (m)</label>
                            <RpDecimalInput id="length" class="rp-input rp-input--num" @bind-Value="Model.LengthM" />
                        </div>
                        <div class="rp-field rp-col-3">
                            <label class="rp-label" for="width">Largura (m)</label>
                            <RpDecimalInput id="width" class="rp-input rp-input--num" @bind-Value="Model.WidthM" />
                        </div>
                        <div class="rp-field rp-col-3">
                            <label class="rp-label" for="height">Altura (m)</label>
                            <RpDecimalInput id="height" class="rp-input rp-input--num" @bind-Value="Model.HeightM" />
                        </div>
                        <div class="rp-field rp-col-3">
                            <label class="rp-label" for="weight">Peso (kg)</label>
                            <RpDecimalInput id="weight" class="rp-input rp-input--num" @bind-Value="Model.WeightKg" />
                        </div>
                    </div>
                </section>
                <section class="rp-client-section rp-col-12" aria-labelledby="rigger-section-title">
                    <h3 id="rigger-section-title" class="rp-section-title">Responsável</h3>
                    <div class="rp-field">
                        <label class="rp-label" for="rigger-name">Nome de exibição</label>
                        <RpTagPicker TItem="Rigger" InputId="rigger-name"
                                     InputValue="@Model.RiggerDisplayName" Suggestions="RiggerSuggestions"
                                     SelectedItem="@(SelectedRigger ?? (IsNewRiggerSelected ? new Rigger { DisplayName = Model.RiggerDisplayName } : null))"
                                     ItemText="@(rigger => $"{rigger.DisplayName} — RPP {rigger.RppNumber}")"
                                     CanCreate="@(!string.IsNullOrWhiteSpace(Model.RiggerDisplayName) && !HasExactRigger)"
                                     CreateLabel="@($"Criar responsável “{Model.RiggerDisplayName?.Trim()}”")"
                                     OnInput="OnRiggerNameInput" OnSelect="OnRiggerSelect"
                                     OnCreate="OnRiggerCreate" OnRemove="OnRiggerRemove" />
                        <ValidationMessage For="() => Model.RiggerDisplayName" />
                        <span class="rp-help">Selecione um cadastro existente ou crie um responsável novo.</span>
                    </div>
                    @if (IsExistingRigger)
                    {
                        <div class="rp-form-grid rp-mt-3">
                            <div class="rp-field rp-col-3"><label class="rp-label">Nome completo</label><input class="rp-input rp-input--disabled" value="@Model.RiggerFullName" disabled /></div>
                            <div class="rp-field rp-col-3"><label class="rp-label">RPP</label><input class="rp-input rp-input--disabled" value="@Model.RiggerRppNumber" disabled /></div>
                            <div class="rp-field rp-col-3"><label class="rp-label">CREA</label><input class="rp-input rp-input--disabled" value="@Model.RiggerCreaNumber" disabled /></div>
                        </div>
                    }
                    else if (IsNewRiggerSelected)
                    {
                        <div class="rp-form-grid rp-mt-3">
                            <div class="rp-field rp-col-3"><label class="rp-label">Nome completo</label><InputText class="rp-input" @bind-Value="Model.RiggerFullName" /><ValidationMessage For="() => Model.RiggerFullName" /></div>
                            <div class="rp-field rp-col-3"><label class="rp-label">RPP</label><InputText class="rp-input" @bind-Value="Model.RiggerRppNumber" /><ValidationMessage For="() => Model.RiggerRppNumber" /></div>
                            <div class="rp-field rp-col-3"><label class="rp-label">CREA</label><InputText class="rp-input" @bind-Value="Model.RiggerCreaNumber" /><ValidationMessage For="() => Model.RiggerCreaNumber" /></div>
                        </div>
                    }
                </section>
                <div class="rp-field rp-col-12"><label class="rp-label" for="observations">Observações</label><InputTextArea id="observations" class="rp-textarea" @bind-Value="Model.Observations" /></div>
            </div>
        </fieldset>
    </EditForm>
</RpCard>

@code {
    [Parameter, EditorRequired] public PlanFormModel Model { get; set; } = new();
    [Parameter] public bool IsReadOnly { get; set; }
    [Parameter] public bool IsSaving { get; set; }
    [Parameter] public string? ErrorMessage { get; set; }
    [Parameter] public IReadOnlyList<Rigger> RiggerOptions { get; set; } = [];
    [Parameter] public IReadOnlyList<Rigger> RiggerSuggestions { get; set; } = [];
    [Parameter] public Rigger? SelectedRigger { get; set; }
    [Parameter] public bool IsNewRiggerSelected { get; set; }
    [Parameter] public bool IsExistingRigger { get; set; }
    [Parameter] public bool HasExactRigger { get; set; }
    [Parameter] public IReadOnlyList<Client> ClientSuggestions { get; set; } = [];
    [Parameter] public Client? SelectedClient { get; set; }
    [Parameter] public bool IsNewClientSelected { get; set; }
    [Parameter] public bool IsExistingClient { get; set; }
    [Parameter] public bool HasExactClient { get; set; }
    [Parameter] public EventCallback OnValidSubmit { get; set; }
    [Parameter] public EventCallback<ChangeEventArgs> OnClientNameInput { get; set; }
    [Parameter] public EventCallback<Client> OnClientSelect { get; set; }
    [Parameter] public EventCallback OnClientCreate { get; set; }
    [Parameter] public EventCallback OnClientRemove { get; set; }
    [Parameter] public EventCallback<ChangeEventArgs> OnClientCnpjInput { get; set; }
    [Parameter] public EventCallback<ChangeEventArgs> OnRiggerNameInput { get; set; }
    [Parameter] public EventCallback<Rigger> OnRiggerSelect { get; set; }
    [Parameter] public EventCallback OnRiggerCreate { get; set; }
    [Parameter] public EventCallback OnRiggerRemove { get; set; }

    private EditContext editContext = null!;

    protected override void OnParametersSet()
    {
        editContext ??= new EditContext(Model);
    }

    public async Task SubmitAsync()
    {
        if (!IsReadOnly && editContext.Validate())
        {
            await OnValidSubmit.InvokeAsync();
        }
    }
}
