@using RiggingPlanner.Domain.Services

@if (Document is not null)
{
    <div class="rp-procedure">
        @foreach (var procedurePage in Document.Pages)
        {
            <article class="rp-procedure-page" aria-label="Página @procedurePage.Number de @Document.Pages.Count do procedimento">
                <header class="rp-procedure-page__header">
                    <div class="rp-procedure-page__brand">
                        <img class="rp-procedure-page__logo" src="images/guindastes-ribas-logo.png" alt="Guindastes Ribas" />
                        <strong class="rp-procedure-page__title">Procedimento</strong>
                    </div>
                    <dl class="rp-procedure-page__meta">
                        <div><dt>Operação</dt><dd>@Document.OperationName</dd></div>
                        <div><dt>ART</dt><dd>@Document.ArtNumber</dd></div>
                        <div><dt>RIGGING</dt><dd>@Document.PlanNumber</dd></div>
                    </dl>
                </header>

                <div class="rp-procedure-page__body">
                    @foreach (var section in procedurePage.Sections)
                    {
                        <section class="rp-procedure-section">
                            <h4 class="rp-procedure-section__title">@($"{section.Number}. {section.Title}")</h4>
                            <p class="rp-procedure-section__objective"><strong>Objetivo:</strong> @section.Objective</p>
                            <p class="rp-procedure-section__label">Passos:</p>
                            <ul class="rp-procedure-section__list">
                                @foreach (var step in section.Steps)
                                {
                                    <li>@step</li>
                                }
                            </ul>
                            <p class="rp-procedure-section__label">Referências:</p>
                            <ul class="rp-procedure-section__list">
                                @foreach (var reference in section.References)
                                {
                                    <li>@reference</li>
                                }
                            </ul>
                        </section>
                    }
                </div>

                <footer class="rp-procedure-page__footer">
                    <span>@OperationalProcedureService.CompanyFooter</span>
                    <span>Página @procedurePage.Number de @Document.Pages.Count</span>
                </footer>
            </article>
        }
    </div>
}

@code {
    [Parameter, EditorRequired] public OperationalProcedureDocument? Document { get; set; }
}
