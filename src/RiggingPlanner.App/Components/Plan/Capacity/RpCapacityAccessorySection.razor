<section class="rp-capacity-section" aria-labelledby="@SectionId" style="height: auto;">
    <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: var(--rp-space-2);">
        <h3 id="@SectionId" class="rp-section-title" style="margin: 0;">@Title</h3>
        @if (!State.IsAdding && State.Form.EditingId is null)
        {
            <button class="rp-btn rp-btn--primary rp-btn--sm" type="button" @onclick="State.StartAdd"
                    title="@AddTitle"
                    style="width: 2rem; height: 2rem; padding: 0; display: grid; place-items: center; font-size: 1.35rem; font-weight: 400; line-height: 1;">+</button>
        }
    </div>
    <p class="rp-help" style="margin-bottom: var(--rp-space-3);">@HelpText</p>

    <div class="rp-table-wrap"
         style="background: var(--rp-surface); border-radius: var(--rp-radius-md); padding: var(--rp-space-2); border: 1px solid var(--rp-border-subtle);">
        <table class="rp-table" style="background: transparent;">
            <thead>
                <tr>
                    <th style="width: 70px;">Item</th>
                    <th>Descrição</th>
                    @if (State.ShowDrawingRef)
                    {
                        <th style="width: 120px;">Ref. / Desenho</th>
                    }
                    <th class="rp-num" style="width: @QuantityWidth;">@QuantityHeader</th>
                    <th class="rp-num" style="width: @UnitWidth;">Unitário (kg)</th>
                    <th class="rp-num" style="width: @TotalWidth;">Total (kg)</th>
                    <th style="width: 160px;"></th>
                </tr>
            </thead>
            <tbody>
                @if (State.IsAdding || State.Form.EditingId is not null)
                {
                    <tr style="background: var(--rp-primary-50); outline: 2px solid var(--rp-primary-300);">
                        <td><span class="rp-badge rp-badge--primary">@(State.Form.EditingId is not null ? "Edit" : "Novo")</span></td>
                        <td>
                            <InputText class="rp-input rp-input--sm" @bind-Value="State.Form.Description"
                                       placeholder="@DescriptionPlaceholder" />
                        </td>
                        @if (State.ShowDrawingRef)
                        {
                            <td>
                                <InputText class="rp-input rp-input--sm" @bind-Value="State.Form.DrawingRef"
                                           placeholder="Ref..." />
                            </td>
                        }
                        <td>
                            <RpDecimalInput class="rp-input rp-input--sm rp-input--num"
                                            @bind-Value="State.Form.Quantity" />
                        </td>
                        <td>
                            <RpDecimalInput class="rp-input rp-input--sm rp-input--num"
                                            @bind-Value="State.Form.UnitWeightKg" />
                        </td>
                        <td class="rp-num" style="font-weight: 600;">
                            @(((State.Form.Quantity ?? 0) * (State.Form.UnitWeightKg ?? 0)).ToString("N2")) kg
                        </td>
                        <td class="rp-row-actions" style="display: flex; gap: var(--rp-space-1);">
                            <button class="rp-btn rp-btn--primary rp-btn--sm" type="button"
                                    @onclick="State.Save">Salvar</button>
                            <button class="rp-btn rp-btn--ghost rp-btn--sm" type="button"
                                    @onclick="State.Cancel">Cancelar</button>
                        </td>
                    </tr>
                }

                @{
                    var index = State.StartIndex;
                }
                @foreach (var item in State.Items)
                {
                    <tr>
                        <td>@(index++)</td>
                        <td>@item.Description</td>
                        @if (State.ShowDrawingRef)
                        {
                            <td>@(string.IsNullOrWhiteSpace(item.DrawingRef) ? "-" : item.DrawingRef)</td>
                        }
                        <td class="rp-num">@item.Quantity.ToString("N2")</td>
                        <td class="rp-num">@item.UnitWeightKg.ToString("N2") kg</td>
                        <td class="rp-num">@((item.Quantity * item.UnitWeightKg).ToString("N2")) kg</td>
                        <td class="rp-row-actions">
                            <button class="rp-btn rp-btn--ghost rp-btn--sm" type="button"
                                    @onclick="() => State.Edit(item)">Editar</button>
                            <button class="rp-btn rp-btn--danger-outline rp-btn--sm" type="button"
                                    @onclick="() => State.AskRemove(item)">Excluir</button>
                        </td>
                    </tr>
                    @if (State.PendingRemoval == item)
                    {
                        <tr class="rp-row--inactive">
                            <td colspan="@(State.ShowDrawingRef ? 7 : 6)">
                                <div class="rp-alert rp-alert--danger rp-confirm"
                                     style="display: flex; align-items: center; justify-content: space-between; padding: var(--rp-space-2) var(--rp-space-3); margin: 0;">
                                    <span>@ConfirmText</span>
                                    <div style="display: flex; gap: var(--rp-space-2);">
                                        <button class="rp-btn rp-btn--danger rp-btn--sm" type="button"
                                                @onclick="State.ConfirmRemove">Sim, excluir</button>
                                        <button class="rp-btn rp-btn--ghost rp-btn--sm" type="button"
                                                @onclick="State.CancelRemove">Cancelar</button>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                }
                @if (!State.Items.Any() && !State.IsAdding && State.Form.EditingId is null)
                {
                    <tr>
                        <td colspan="@(State.ShowDrawingRef ? 7 : 6)" class="rp-muted"
                            style="text-align: center; padding: var(--rp-space-4);">@EmptyText</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div style="margin-top: var(--rp-space-3); font-weight: 600; color: var(--rp-primary-800); text-align: right;">
        @TotalLabel: @State.Total.ToString("N2") kg
    </div>
</section>

@code {
    [Parameter, EditorRequired] public CapacityAccessoryState State { get; set; } = null!;
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string SectionId { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string HelpText { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string TotalLabel { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string EmptyText { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string AddTitle { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string ConfirmText { get; set; } = string.Empty;
    [Parameter] public string DescriptionPlaceholder { get; set; } = "Descrição...";
    [Parameter] public string QuantityHeader { get; set; } = "Qtd.";
    [Parameter] public string QuantityWidth { get; set; } = "90px";
    [Parameter] public string UnitWidth { get; set; } = "130px";
    [Parameter] public string TotalWidth { get; set; } = "120px";
}
