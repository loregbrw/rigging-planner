<section class="rp-capacity-section" aria-labelledby="quadrant-section">
    <h3 id="quadrant-section" class="rp-section-title">Quadrante operacional</h3>
    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: var(--rp-space-3);">
        <div class="rp-field" style="margin: 0;">
            <label class="rp-label">Inicial</label>
            <select class="rp-input" @bind="Plan.QuadrantStart">
                <option value="">Selecione...</option>
                <option value="LATERAL">LATERAL</option>
                <option value="TRASEIRO">TRASEIRO</option>
                <option value="FRONTAL">FRONTAL</option>
                <option value="360 GRAUS">360 GRAUS</option>
            </select>
        </div>
        <div class="rp-field" style="margin: 0;">
            <label class="rp-label">Final</label>
            <select class="rp-input" @bind="Plan.QuadrantEnd">
                <option value="">Selecione...</option>
                <option value="LATERAL">LATERAL</option>
                <option value="TRASEIRO">TRASEIRO</option>
                <option value="FRONTAL">FRONTAL</option>
                <option value="360 GRAUS">360 GRAUS</option>
            </select>
        </div>
    </div>
</section>

@code {
    [Parameter, EditorRequired] public RiggingPlan Plan { get; set; } = null!;
}
