<div class="rp-modal-backdrop" @onclick="OnClose">
    <div class="rp-modal" @onclick:stopPropagation="true" role="dialog" aria-modal="true"
         aria-labelledby="preview-modal-title">
        <div class="rp-modal__header">
            <div>
                <h2 id="preview-modal-title" class="rp-section-title">Visualização -
                    @Drawing.File.OriginalName</h2>
                <span class="rp-help">@AttachmentsState.FormatByteSize(Drawing.File.SizeBytes)</span>
            </div>
            <button class="rp-btn rp-btn--ghost rp-btn--sm" type="button" @onclick="OnClose">✕</button>
        </div>
        <div
            style="display: grid; place-items: center; background: var(--rp-surface-subtle); border-radius: var(--rp-radius-md); padding: var(--rp-space-3); max-height: 60vh; overflow: auto;">
            <img src="@AttachmentsState.GetFileAsDataUri(Drawing.File)" alt="@Drawing.File.OriginalName"
                 style="max-width: 100%; max-height: 55vh; object-fit: contain; border-radius: var(--rp-radius-sm);" />
        </div>
        <div
            style="display: flex; justify-content: flex-end; gap: var(--rp-space-2); margin-top: var(--rp-space-4);">
            @if (!IsReadOnly)
            {
                <button class="rp-btn rp-btn--danger-outline" type="button"
                        @onclick="RemoveAsync">Excluir imagem</button>
            }
            <button class="rp-btn rp-btn--ghost-outline" type="button" @onclick="OnClose">Fechar</button>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public PlanDrawing Drawing { get; set; } = null!;
    [Parameter] public bool IsReadOnly { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<PlanDrawing> OnRemove { get; set; }

    private async Task RemoveAsync()
    {
        await OnRemove.InvokeAsync(Drawing);
        await OnClose.InvokeAsync();
    }
}
