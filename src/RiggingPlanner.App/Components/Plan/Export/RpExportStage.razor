@inject NavigationManager Navigation
@inject PlanDraftState Draft
@inject IPlanService Plans
@inject ICatalogService Catalog
@inject IExportService ExportService

<RpCard Title="Exportação">
    <p class="rp-muted">
        O PDF completo reúne a folha-resumo, as folhas de desenho, a ART do plano, o procedimento operacional e o laudo técnico do equipamento.
    </p>

    @if (!IsReadOnly)
    {
        <div class="rp-form-actions">
            <button class="rp-btn rp-btn--primary" type="button" disabled="@isBusy" @onclick="SaveAndExportAsync">
                Salvar e exportar
            </button>
            <button class="rp-btn rp-btn--danger" type="button" disabled="@isBusy" @onclick="OpenFinalizeModalAsync">
                Finalizar plano
            </button>
        </div>
    }
    else
    {
        <div class="rp-form-actions">
            <button class="rp-btn rp-btn--primary" type="button" disabled="@isBusy" @onclick="ExportAsync">
                Exportar PDF completo
            </button>
        </div>
    }

    <div class="rp-export-messages">
        @if (isBusy)
        {
            <p class="rp-muted">Processando...</p>
        }
        @if (errorMessage is not null)
        {
            <div class="rp-alert rp-alert--danger">@errorMessage</div>
        }
        @foreach (var validationError in validationErrors)
        {
            <div class="rp-alert rp-alert--danger">@validationError</div>
        }
        @if (successMessage is not null)
        {
            <div class="rp-alert rp-alert--success">@successMessage</div>
        }
        @foreach (var warning in exportWarnings)
        {
            <div class="rp-alert rp-alert--warning">@warning</div>
        }
    </div>
</RpCard>

@if (showFinalizeModal)
{
    <div class="rp-modal-backdrop" @onclick="() => showFinalizeModal = false">
        <section class="rp-modal" role="dialog" aria-modal="true" @onclick:stopPropagation>
            <div class="rp-modal__header"><h2>Finalizar plano</h2></div>
            <p class="rp-muted">
                Ao finalizar o plano @planNumber: ele não poderá mais ser editado nem reaberto; o procedimento operacional ficará congelado com o texto atual; você ainda poderá exportar o PDF quantas vezes quiser. As alterações não salvas do formulário serão salvas antes de finalizar.
            </p>
            @foreach (var warning in modalWarnings)
            {
                <div class="rp-alert rp-alert--warning">@warning</div>
            }
            @if (errorMessage is not null)
            {
                <div class="rp-alert rp-alert--danger">@errorMessage</div>
            }
            @foreach (var validationError in validationErrors)
            {
                <div class="rp-alert rp-alert--danger">@validationError</div>
            }
            <div class="rp-form-actions">
                <button class="rp-btn rp-btn--ghost" type="button" disabled="@isBusy" @onclick="() => showFinalizeModal = false">Cancelar</button>
                <button class="rp-btn rp-btn--danger" type="button" disabled="@isBusy" @onclick="FinalizeAsync">Finalizar plano</button>
            </div>
        </section>
    </div>
}

@code {
    [Parameter] public Guid PlanId { get; set; }
    [Parameter] public bool IsReadOnly { get; set; }
    [Parameter] public EventCallback OnFinalized { get; set; }

    private bool isBusy;
    private bool showFinalizeModal;
    private string? errorMessage;
    private string? successMessage;
    private string? planNumber;
    private IReadOnlyList<string> validationErrors = [];
    private IReadOnlyList<string> exportWarnings = [];
    private IReadOnlyList<string> modalWarnings = [];

    private void ClearMessages()
    {
        errorMessage = null;
        successMessage = null;
        validationErrors = [];
        exportWarnings = [];
    }

    private async Task<PlanSaveRequest> BuildRequestAsync()
    {
        List<Equipment> equipmentOptions = [.. await Catalog.GetEquipmentsAsync(activeOnly: true)];
        List<Rigger> riggerOptions = [.. await Catalog.GetRiggersAsync(activeOnly: true)];

        if (Draft.Plan?.EquipmentId is not null && equipmentOptions.All(x => x.Id != Draft.Plan.EquipmentId))
        {
            var linked = await Catalog.FindEquipmentAsync(Draft.Plan.EquipmentId.Value);
            if (linked is not null) equipmentOptions.Add(linked);
        }
        if (Draft.Plan?.RiggerId is not null && riggerOptions.All(x => x.Id != Draft.Plan.RiggerId))
        {
            var linked = await Catalog.FindRiggerAsync(Draft.Plan.RiggerId.Value);
            if (linked is not null) riggerOptions.Add(linked);
        }

        return new PlanSaveRequest
        {
            PlanId = Draft.IsPersisted ? Draft.PlanId : null,
            IsDraftPlan = !Draft.IsPersisted,
            Form = Draft.Form,
            CapacitySource = Draft.Plan,
            Accessories = Draft.Accessories,
            AttachmentSource = Draft.Plan,
            EquipmentOptions = equipmentOptions,
            RiggerOptions = riggerOptions
        };
    }

    private async Task SaveAndExportAsync()
    {
        isBusy = true;
        ClearMessages();
        try
        {
            var result = await Plans.SaveAsync(await BuildRequestAsync());
            if (result.ValidationErrors.Count > 0)
            {
                validationErrors = result.ValidationErrors;
                return;
            }
            if (result.Error is not null)
            {
                errorMessage = result.Error;
                return;
            }

            var savedId = result.PlanId!.Value;
            await ExportSavedPlanAsync(savedId);

            if (Draft.PlanId != savedId || !Draft.IsPersisted)
            {
                Draft.PlanId = savedId;
                Draft.IsPersisted = true;
                Draft.IsInitialized = true;
                Navigation.NavigateTo($"/new-plan/{savedId}/export", replace: true);
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Não foi possível salvar e exportar o plano: {ex.Message}";
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task ExportAsync()
    {
        isBusy = true;
        ClearMessages();
        try
        {
            await ExportSavedPlanAsync(Draft.PlanId!.Value);
        }
        catch (Exception ex)
        {
            errorMessage = $"Não foi possível gerar o PDF: {ex.Message}";
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task ExportSavedPlanAsync(Guid savedPlanId)
    {
        var document = await ExportService.BuildAsync(savedPlanId);
        var filePath = await PlanPdfWriter.SaveAndOpenAsync(document);
        successMessage = $"PDF gerado: {filePath}";
        exportWarnings = document.Warnings;
    }

    private async Task OpenFinalizeModalAsync()
    {
        isBusy = true;
        ClearMessages();
        try
        {
            var errors = PlanFormValidator.Validate(Draft.Form);
            if (errors.Count > 0)
            {
                validationErrors = errors;
                return;
            }

            planNumber = string.IsNullOrWhiteSpace(Draft.Plan?.PlanNumber)
                ? "ainda sem número"
                : Draft.Plan.PlanNumber;
            modalWarnings = Draft.IsPersisted && Draft.PlanId is not null
                ? await ExportService.GetWarningsAsync(Draft.PlanId.Value)
                : [];
            showFinalizeModal = true;
        }
        catch (Exception ex)
        {
            errorMessage = $"Não foi possível abrir a finalização: {ex.Message}";
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task FinalizeAsync()
    {
        isBusy = true;
        errorMessage = null;
        validationErrors = [];
        var wasPersisted = Draft.IsPersisted;
        try
        {
            var result = await Plans.FinalizeAsync(await BuildRequestAsync());
            validationErrors = result.ValidationErrors;
            if (validationErrors.Count > 0)
            {
                return;
            }
            if (result.Error is not null)
            {
                errorMessage = result.Error;
                return;
            }

            showFinalizeModal = false;
            var savedId = result.PlanId!.Value;
            await PlanDraftLoader.LoadAsync(Plans, Draft, savedId, includeAccessories: true);
            Draft.IsPersisted = true;
            Draft.IsInitialized = true;
            if (!wasPersisted || savedId != PlanId)
            {
                Navigation.NavigateTo($"/new-plan/{savedId}/export", replace: true, forceLoad: true);
            }
            else
            {
                await OnFinalized.InvokeAsync();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Não foi possível finalizar o plano: {ex.Message}";
        }
        finally
        {
            isBusy = false;
        }
    }
}
