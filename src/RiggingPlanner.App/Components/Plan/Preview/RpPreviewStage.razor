@inject PlanDraftState Draft
@inject IExportService ExportService
@implements IDisposable

<RpCard Title="Pré-visualização">
    @if (!Draft.IsPersisted)
    {
        <p class="rp-muted">Salve o plano para ver o preview.</p>
    }
    else
    {
        <div class="rp-preview-header">
            <p class="rp-muted">Páginas do PDF final, geradas a partir da versão salva do plano.</p>
            <button class="rp-btn rp-btn--ghost" type="button"
                    disabled="@isGenerating"
                    @onclick="GenerateAsync">
                Atualizar
            </button>
        </div>

        @if (isGenerating)
        {
            <p class="rp-muted">Gerando preview…</p>
        }
        else if (errorMessage is not null)
        {
            <div class="rp-alert rp-alert--danger">@errorMessage</div>
        }
        else
        {
            @if (warnings.Count > 0)
            {
                <div class="rp-alert rp-alert--warning">
                    @foreach (var warning in warnings)
                    {
                        <div>@warning</div>
                    }
                </div>
            }

            @if (pages.Count > 0)
            {
                <div class="rp-doc-preview">
                    @foreach (var page in pages)
                    {
                        <figure class="rp-doc-page">
                            <img src="@(page.DataUrl)" alt="Página @(page.Number) do plano" />
                            <figcaption class="rp-muted">Página @(page.Number) de @pages.Count</figcaption>
                        </figure>
                    }
                </div>
            }
        }
    }
</RpCard>

@code {
    private sealed record PreviewPage(int Number, string DataUrl);

    private readonly List<PreviewPage> pages = [];
    private readonly List<string> warnings = [];
    private byte[]? generatedPdf;
    private bool isGenerating;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        if (Draft.IsPersisted)
        {
            await GenerateAsync();
        }
    }

    private async Task GenerateAsync()
    {
        if (isGenerating)
        {
            return;
        }

        isGenerating = true;
        errorMessage = null;
        pages.Clear();
        warnings.Clear();
        StateHasChanged();

        try
        {
            var (pdf, pdfWarnings) = await BuildPdfAsync();
            var images = await RasterizePagesAsync(pdf);

            generatedPdf = pdf;
            warnings.AddRange(pdfWarnings);
            pages.AddRange(images);
        }
        catch (Exception ex)
        {
            generatedPdf = null;
            warnings.Clear();
            pages.Clear();
            errorMessage = $"Não foi possível gerar o preview: {ex.Message}";
        }
        finally
        {
            isGenerating = false;
        }
    }

    private async Task<(byte[] Pdf, List<string> Warnings)> BuildPdfAsync()
    {
        var document = await ExportService.BuildAsync(Draft.PlanId!.Value);
        return (document.Pdf, [.. document.Warnings]);
    }

    private static async Task<List<PreviewPage>> RasterizePagesAsync(byte[] pdf)
    {
        return await Task.Run(() =>
        {
            var images = new List<PreviewPage>();
            var pageCount = PDFtoImage.Conversion.GetPageCount(pdf);
            for (var index = 0; index < pageCount; index++)
            {
                using var bitmap = PDFtoImage.Conversion.ToImage(
                    pdf, index, options: new PDFtoImage.RenderOptions { Dpi = 110 });
                using var image = SkiaSharp.SKImage.FromBitmap(bitmap);
                using var data = image.Encode(SkiaSharp.SKEncodedImageFormat.Png, 100);
                var dataUrl = $"data:image/png;base64,{Convert.ToBase64String(data.ToArray())}";
                images.Add(new PreviewPage(index + 1, dataUrl));
            }
            return images;
        });
    }

    public void Dispose()
    {
        generatedPdf = null;
        pages.Clear();
        warnings.Clear();
    }
}
